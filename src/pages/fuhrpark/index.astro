---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';

const fahrzeuge = (await getCollection('fahrzeuge')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
---

<Basis titel="Fuhrpark – Feuerwehr Weiden">
  <main>
    <section class="subhero" style="min-height:44svh">
      <div class="bild" style="background-image:url(/bilder/fahrzeuge/dlak.jpg)"></div>
      <div class="duster"></div>
      <div class="inhalt">
        <div class="wrap">
          <span class="eyebrow">Fahrzeuge &amp; Anhänger</span>
          <h1 class="display">Unser Fuhrpark</h1>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        <div class="fuhrparkliste">
          {
            fahrzeuge.map((f) => (
              <a class="fahrzeugkarte reveal" href={`/fuhrpark/${f.id}/`}>
                <div class="bildbox">
                  <img src={f.data.bild} alt={f.data.name} loading="lazy" />
                </div>
                <div class="txt">
                  <span class="typ">{f.data.typ}</span>
                  <h2>{f.data.name}</h2>
                  <span class="funk">{f.data.funkruf}</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .fuhrparkliste {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 960px) {
    .fuhrparkliste {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .fuhrparkliste {
      grid-template-columns: 1fr;
    }
  }
  .fahrzeugkarte {
    background: var(--karte);
    border: 1px solid var(--linie);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 10px rgba(20, 22, 28, 0.04);
  }
  .fahrzeugkarte:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(20, 22, 28, 0.14);
  }
  .fahrzeugkarte .bildbox {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .fahrzeugkarte img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .fahrzeugkarte:hover img {
    transform: scale(1.06);
  }
  .fahrzeugkarte .txt {
    padding: 16px 18px 18px;
  }
  .fahrzeugkarte .typ {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinte2);
  }
  .fahrzeugkarte h2 {
    margin: 6px 0 8px;
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: 1.45rem;
    line-height: 1;
  }
  .fahrzeugkarte .funk {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--rot);
  }
</style>
