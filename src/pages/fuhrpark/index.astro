---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';

const alle = (await getCollection('fahrzeuge')).filter((f) => !f.data.entwurf);

/* Fachliche Gruppen in fester Reihenfolge; innerhalb der Gruppe zuerst
   Hauptwache/Wache 2, dann die Ortsteile – jeweils nach "reihenfolge". */
const GRUPPEN = [
  { id: 'elw-kdow', titel: 'Einsatzleitwagen / Kommandowagen' },
  { id: 'loesch', titel: 'Lösch- und Tanklöschfahrzeuge' },
  { id: 'hubrettung', titel: 'Hubrettungsfahrzeuge' },
  { id: 'ruest-geraete', titel: 'Rüst- und Gerätewagen' },
  { id: 'sonstige', titel: 'Sonstige Fahrzeuge' },
  { id: 'anhaenger', titel: 'Anhänger' },
  { id: 'rollcontainer', titel: 'Rollcontainer' },
  { id: 'ehemalige', titel: 'Ehemalige Fahrzeuge' },
] as const;

const rang = (f: (typeof alle)[number]) => (f.data.standort === 'Hauptfeuerwache' ? 0 : 1);
const gruppen = GRUPPEN.map((g) => ({
  ...g,
  fahrzeuge: alle
    .filter((f) => f.data.gruppe === g.id)
    .sort((a, b) => rang(a) - rang(b) || a.data.reihenfolge - b.data.reihenfolge),
})).filter((g) => g.fahrzeuge.length > 0);

/* Fahrzeug/Anhänger wird aus der Gruppe abgeleitet: Gruppe "Anhänger" = Anhänger, alles andere = Fahrzeug */
const anzahlAnhaenger = alle.filter((f) => f.data.gruppe === 'anhaenger').length;
const anzahlFahrzeuge = alle.length - anzahlAnhaenger;
---

<Basis titel="Fuhrpark – Feuerwehr Weiden">
  <main>
    <Seitenkopf titel="Unser Fuhrpark" krumen={[{ name: 'Start', href: '/' }, { name: `${anzahlFahrzeuge} Fahrzeuge · ${anzahlAnhaenger} Anhänger` }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        {
          gruppen.map((g, gi) => (
            <div class="gruppe" style={gi === gruppen.length - 1 ? 'margin-bottom:0' : undefined}>
              <span class="eyebrow">{g.fahrzeuge.length} {g.fahrzeuge.length === 1 ? 'Fahrzeug' : 'Fahrzeuge'}</span>
              <h2 class="titel display reveal">{g.titel}</h2>
              <div class:list={[g.id === 'anhaenger' ? 'anhaengerband' : 'mosaik']}>
                {g.fahrzeuge.map((f, i) => (
                  <a class:list={[g.id === 'anhaenger' ? 'anh' : 'fzk', 'reveal']} href={`/fuhrpark/${f.id}/`}>
                    {
                      f.data.bild ? (
                        <img src={f.data.bild} alt={f.data.name} loading={gi === 0 && i < 3 ? 'eager' : 'lazy'} />
                      ) : (
                        <span class="ohne" aria-hidden="true">
                          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 15h13v-6a2 2 0 0 1 2-2h5M15 15h4m3 0h-3m-3.5 2.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/><path d="M2 15v-4h6v4"/></svg>
                        </span>
                      )
                    }
                    <span class="schatten" aria-hidden="true" />
                    <span class="txt">
                      <em>{f.data.standort === 'Hauptfeuerwache' ? f.data.typ : f.data.standort}</em>
                      <b>{f.data.name}</b>
                      {f.data.funkruf && <i>{f.data.funkruf}</i>}
                    </span>
                    {g.id !== 'anhaenger' && <span class="pfeil" aria-hidden="true">↗</span>}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Basis>

<style>
  .gruppe {
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .gruppe .titel {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin-bottom: 26px;
  }

  /* ---- Einheitliches Raster ---- */
  .mosaik {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .fzk {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    background: var(--dunkel2);
    aspect-ratio: 16 / 11;
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .fzk:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 48px rgba(20, 22, 28, 0.22);
  }
  .fzk img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .fzk:hover img {
    transform: scale(1.07);
  }
  .fzk .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.88) 0%, rgba(10, 12, 16, 0.25) 45%, transparent 70%);
  }
  .fzk .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px;
    display: grid;
    gap: 2px;
  }
  .fzk .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .fzk .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    line-height: 1;
  }
  .fzk .txt i {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #ffb300;
    font-variant-numeric: tabular-nums;
  }
  .fzk .pfeil {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.3);
    font-size: 0.9rem;
    opacity: 0;
    transition: opacity 0.25s, transform 0.25s, background 0.25s;
  }
  .fzk:hover .pfeil {
    opacity: 1;
    background: var(--rot);
    border-color: var(--rot);
    transform: rotate(45deg);
  }
  .fzk:hover .txt i {
    text-shadow: 0 0 14px rgba(255, 179, 0, 0.8);
  }

  /* ---- Anhänger: kompaktes Band ---- */
  .anhaengerband {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .anh {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    aspect-ratio: 16/10;
    background: var(--dunkel2);
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .anh:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(20, 22, 28, 0.2);
  }
  .anh img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .anh:hover img {
    transform: scale(1.06);
  }
  .anh .ohne,
  .fzk .ohne {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.35);
    background: repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.03) 0 14px, transparent 14px 28px);
  }
  .anh .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.85) 0%, transparent 55%);
  }
  .anh .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px;
    display: grid;
    gap: 2px;
  }
  .anh .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .anh .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: 1.15rem;
    line-height: 1;
  }

  /* ---- Responsive ---- */
  @media (max-width: 820px) {
    .mosaik {
      grid-template-columns: repeat(2, 1fr);
    }
    .anhaengerband {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .mosaik,
    .anhaengerband {
      grid-template-columns: 1fr;
    }
    .fzk,
    .anh {
      aspect-ratio: 16 / 9;
    }
  }
</style>
