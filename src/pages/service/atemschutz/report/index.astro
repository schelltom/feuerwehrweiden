---
import { getCollection } from 'astro:content';
import Basis from '../../../../layouts/Basis.astro';
import Seitenkopf from '../../../../components/Seitenkopf.astro';
import PflegeReport from '../../../../components/PflegeReport.astro';
import { ladePflege } from '../../../../lib/pflege';

const vorgaenge = await ladePflege();
const wehren = (await getCollection('wehren')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'de'));
const stand = new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date());
---

<Basis titel="Report Atemschutzwerkstatt & Schlauchpflegestelle – Feuerwehr Weiden">
  <main>
    <Seitenkopf titel="Report" krumen={[{ name: 'Start', href: '/' }, { name: 'Atemschutzwerkstatt & Schlauchpflegestelle', href: '/service/atemschutz/' }, { name: 'Report' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(36px,5vw,56px);padding-bottom:64px">
        <div class="reportkopf">
          <div>
            <h2 class="display drucktitel">Atemschutzwerkstatt &amp; Schlauchpflegestelle – Gesamtreport</h2>
            <span class="stand">Stand: {stand}</span>
          </div>
          <div class="aktionen keindruck">
            <button class="btn btn-rot" onclick="window.print()">Drucken</button>
            <a class="zurueck" href="/service/atemschutz/">← zur Atemschutzwerkstatt & Schlauchpflegestelle</a>
          </div>
        </div>

        <div class="wehrwahl keindruck">
          <span>Report je Wehr:</span>
          {wehren.map((w) => <a href={`/service/atemschutz/report/${w.id}/`}>{w.data.name}</a>)}
        </div>

        <PflegeReport vorgaenge={vorgaenge} />
      </div>
    </section>
  </main>
</Basis>

<style>
  .reportkopf {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .drucktitel {
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-style: italic;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .stand {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--tinte2);
  }
  .aktionen {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .aktionen .btn {
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .zurueck {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--tinte2);
  }
  .zurueck:hover {
    color: var(--rot);
  }
  .wehrwahl {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    margin-bottom: 22px;
  }
  .wehrwahl span {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinte2);
    margin-right: 4px;
  }
  .wehrwahl a {
    font-size: 0.82rem;
    text-decoration: none;
    background: var(--karte);
    border: 1px solid var(--linie);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .wehrwahl a:hover {
    border-color: var(--rot);
    color: var(--rot);
  }
  @media print {
    .keindruck,
    :global(.seitenkopf),
    :global(header.nav),
    :global(footer) {
      display: none !important;
    }
    :global(body) {
      background: #fff;
    }
  }
</style>
