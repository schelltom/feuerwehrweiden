---
import { getCollection } from 'astro:content';
import Basis from '../../../../layouts/Basis.astro';
import Seitenkopf from '../../../../components/Seitenkopf.astro';
import PflegeReport from '../../../../components/PflegeReport.astro';
import { ladePflege } from '../../../../lib/pflege';

export async function getStaticPaths() {
  return (await getCollection('wehren')).map((w) => ({
    params: { wehr: w.id },
    props: { wehrName: w.data.name },
  }));
}

const { wehr } = Astro.params;
const { wehrName } = Astro.props;
const vorgaenge = (await ladePflege()).filter((v) => v.wehr === wehr);
const stand = new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date());
---

<Basis titel={`Report ${wehrName} – Atemschutzwerkstatt Feuerwehr Weiden`}>
  <main>
    <Seitenkopf titel={wehrName} krumen={[{ name: 'Start', href: '/' }, { name: 'Atemschutzwerkstatt', href: '/service/atemschutz/' }, { name: 'Report', href: '/service/atemschutz/report/' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(36px,5vw,56px);padding-bottom:64px">
        <div class="reportkopf">
          <div>
            <h2 class="display drucktitel">Atemschutzwerkstatt – Report {wehrName}</h2>
            <span class="stand">Stand: {stand}</span>
          </div>
          <div class="aktionen keindruck">
            <button class="btn btn-rot" onclick="window.print()">Drucken</button>
            <a class="zurueck" href="/service/atemschutz/report/">← Gesamtreport</a>
          </div>
        </div>

        <PflegeReport vorgaenge={vorgaenge} mitWehr={false} />
      </div>
    </section>
  </main>
</Basis>

<style>
  .reportkopf {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .drucktitel {
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-style: italic;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .stand {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--tinte2);
  }
  .aktionen {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .aktionen .btn {
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .zurueck {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--tinte2);
  }
  .zurueck:hover {
    color: var(--rot);
  }
  @media print {
    .keindruck,
    :global(.seitenkopf),
    :global(header.nav),
    :global(footer) {
      display: none !important;
    }
    :global(body) {
      background: #fff;
    }
  }
</style>
