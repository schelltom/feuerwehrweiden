---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Einsatzbilanz from '../../components/Einsatzbilanz.astro';
import { ladeEinsaetze } from '../../lib/einsaetze';

export async function getStaticPaths({ paginate }) {
  return paginate(await ladeEinsaetze(), { pageSize: 15 });
}

const { page } = Astro.props;
---

<Basis titel="Einsätze – Feuerwehr Weiden">
  <main>
    <Seitenkopf krumen={[{ name: 'Start', href: '/' }, { name: page.lastPage > 1 ? `Einsätze · Seite ${page.currentPage} von ${page.lastPage}` : 'Einsätze' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px);max-width:980px">
        {
          page.currentPage === 1 && (
            <div style="margin-bottom:clamp(36px,5vw,56px)">
              <Einsatzbilanz />
            </div>
          )
        }

        <ul class="einsatzliste">
          {
            page.data.map((e) => (
              <li>
                <span class="zeit">{e.datum} · {e.zeit} Uhr</span>
                <b class:list={['art', e.art.toLowerCase()]}>{e.art}</b>
                <span class="stichwort">{e.stichwort}</span>
              </li>
            ))
          }
        </ul>

        {
          page.lastPage > 1 && (
            <nav class="blaettern" aria-label="Seiten">
              {page.url.prev ? <a href={page.url.prev}>← Neuere Einsätze</a> : <span />}
              <span class="stand">Seite {page.currentPage} / {page.lastPage}</span>
              {page.url.next ? <a href={page.url.next}>Ältere Einsätze →</a> : <span />}
            </nav>
          )
        }
      </div>
    </section>
  </main>
</Basis>

<style>
  .einsatzliste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .einsatzliste li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 12px 2px;
    border-bottom: 1px solid var(--linie);
  }
  @media (max-width: 560px) {
    .einsatzliste li {
      grid-template-columns: auto 1fr;
    }
    .einsatzliste .zeit {
      grid-column: 1 / -1;
    }
  }
  .einsatzliste .zeit {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--tinte2);
    white-space: nowrap;
  }
  .einsatzliste .art {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 6px;
    color: #fff;
  }
  .einsatzliste .art.thl { background: #2b54d4; }
  .einsatzliste .art.brand { background: #e10600; }
  .einsatzliste .art.abc { background: #c98a00; }
  .einsatzliste .art.sonstige { background: #1a9b4e; }
  .blaettern {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--linie);
  }
  .blaettern a {
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--tinte);
  }
  .blaettern a:hover {
    color: var(--rot);
  }
  .blaettern a:last-child {
    text-align: right;
  }
  .blaettern .stand {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--tinte2);
  }
</style>
