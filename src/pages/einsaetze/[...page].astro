---
import Basis from '../../layouts/Basis.astro';
import { ladeEinsaetze, anzahlVon } from '../../lib/einsaetze';

/* Donut-Segmente als SVG-Pfade (Start oben, im Uhrzeigersinn) */
const MITTE = 120, R_AUSSEN = 100, R_INNEN = 60;
const punkt = (r, grad) => {
  const rad = ((grad - 90) * Math.PI) / 180;
  return `${(MITTE + r * Math.cos(rad)).toFixed(2)} ${(MITTE + r * Math.sin(rad)).toFixed(2)}`;
};
const segmenteFuer = (arten, gesamt) => {
  let winkel = 0;
  return arten
    .filter((a) => a.n > 0)
    .map((a) => {
      const spanne = (a.n / gesamt) * 360;
      const von = winkel, bis = winkel + Math.min(spanne, 359.98);
      winkel += spanne;
      const gross = spanne > 180 ? 1 : 0;
      return {
        ...a,
        prozent: Math.round((a.n / gesamt) * 100),
        d: `M ${punkt(R_AUSSEN, von)} A ${R_AUSSEN} ${R_AUSSEN} 0 ${gross} 1 ${punkt(R_AUSSEN, bis)} L ${punkt(R_INNEN, bis)} A ${R_INNEN} ${R_INNEN} 0 ${gross} 0 ${punkt(R_INNEN, von)} Z`,
      };
    });
};

export async function getStaticPaths({ paginate }) {
  const einsaetze = await ladeEinsaetze();

  const datumVon = (e) => new Date(e.wann.getFullYear(), e.wann.getMonth(), e.wann.getDate());

  /* Wochengrenzen (Montag 0:00) – berechnet beim Build; die Seite wird
     bei jedem neuen Einsatz ohnehin neu gebaut. */
  const heute = new Date();
  const montag = new Date(heute.getFullYear(), heute.getMonth(), heute.getDate() - ((heute.getDay() + 6) % 7));
  const montagVorwoche = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() - 7);
  const sonntag = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() + 6);
  const sonntagVorwoche = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() - 1);

  const kurz = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit' });
  const lang = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });

  const FARBEN = { THL: '#2B54D4', Brand: '#E10600', Sonstige: '#B7791F' };
  const statsFuer = (titel, von, bis) => {
    const imZeitraum = einsaetze.filter((e) => {
      const d = datumVon(e);
      return d >= von && d <= bis;
    });
    const arten = ['THL', 'Brand', 'Sonstige'].map((name) => ({
      name,
      farbe: FARBEN[name],
      n: imZeitraum.filter((e) => e.art === name).reduce((summe, e) => summe + anzahlVon(e), 0),
    }));
    return {
      titel,
      zeitraum: `${kurz.format(von)} – ${lang.format(bis)}`,
      arten,
      gesamt: arten.reduce((summe, a) => summe + a.n, 0),
    };
  };

  const wochen = [
    statsFuer('Aktuelle Woche', montag, sonntag),
    statsFuer('Letzte Woche', montagVorwoche, sonntagVorwoche),
  ];

  return paginate(einsaetze, { pageSize: 15, props: { wochen } });
}

const { page, wochen } = Astro.props;
---

<Basis titel="Einsätze – Feuerwehr Weiden">
  <main>
    <section class="subhero" style="min-height:44svh">
      <div class="bild" style="background-image:url(/bilder/header/nachtbrand.jpg)"></div>
      <div class="duster"></div>
      <div class="inhalt">
        <div class="wrap">
          <span class="eyebrow">Einsätze{page.lastPage > 1 && ` · Seite ${page.currentPage} von ${page.lastPage}`}</span>
          <h1 class="display">Einsätze &amp; Statistik</h1>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px);max-width:900px">
        {
          page.currentPage === 1 && (
            <div class="statistik">
              {wochen.map((w) => {
                const segmente = segmenteFuer(w.arten, w.gesamt);
                return (
                  <div class="woche">
                    <span class="eyebrow">{w.titel}</span>
                    <span class="zeitraum">{w.zeitraum}</span>
                    <div class="torte">
                      <svg viewBox="0 0 240 240" role="img" aria-label={`${w.titel}: ${w.gesamt} Einsätze nach Art`}>
                        {w.gesamt === 0 && <circle cx="120" cy="120" r="80" fill="none" stroke="var(--linie)" stroke-width="40" />}
                        {segmente.map((s) => (
                          <path d={s.d} fill={s.farbe} stroke="var(--karte)" stroke-width="2">
                            <title>{`${s.name}: ${s.n} (${s.prozent} %)`}</title>
                          </path>
                        ))}
                      </svg>
                      <div class="mitte">
                        <b>{w.gesamt}</b>
                        <span>{w.gesamt === 1 ? 'Einsatz' : 'Einsätze'}</span>
                      </div>
                    </div>
                    <ul class="legende">
                      {w.arten.map((a) => (
                        <li>
                          <i style={`background:${a.farbe}`} />
                          <span class="wert">{a.n}</span>
                          <span class="name">{a.name}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          )
        }

        <ul class="einsatzliste">
          {
            page.data.map((e) => (
              <li>
                <span class="zeit">{e.datum} · {e.zeit} Uhr</span>
                <b class:list={['art', e.art.toLowerCase()]}>{e.art}</b>
                <span class="stichwort">{e.stichwort}</span>
              </li>
            ))
          }
        </ul>

        {
          page.lastPage > 1 && (
            <nav class="blaettern" aria-label="Seiten">
              {page.url.prev ? <a href={page.url.prev}>← Neuere Einsätze</a> : <span />}
              <span class="stand">Seite {page.currentPage} / {page.lastPage}</span>
              {page.url.next ? <a href={page.url.next}>Ältere Einsätze →</a> : <span />}
            </nav>
          )
        }
      </div>
    </section>
  </main>
</Basis>

<style>
  .statistik {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    background: var(--karte);
    border: 1px solid var(--linie);
    border-radius: 18px;
    padding: clamp(24px, 4vw, 40px);
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  @media (max-width: 640px) {
    .statistik {
      grid-template-columns: 1fr;
    }
  }
  .woche {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 6px;
  }
  .woche .zeitraum {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--tinte2);
  }
  .torte {
    position: relative;
    width: clamp(150px, 20vw, 200px);
    margin-top: 8px;
  }
  .torte svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .torte path:hover {
    opacity: 0.85;
  }
  .mitte {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    pointer-events: none;
  }
  .mitte b {
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.4vw, 2.3rem);
    line-height: 1;
  }
  .mitte span {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinte2);
  }
  .legende {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .legende li {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .legende i {
    width: 11px;
    height: 11px;
    border-radius: 4px;
  }
  .legende .wert {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .legende .name {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--tinte2);
    text-transform: uppercase;
  }
  .einsatzliste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .einsatzliste li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 12px 2px;
    border-bottom: 1px solid var(--linie);
  }
  @media (max-width: 560px) {
    .einsatzliste li {
      grid-template-columns: auto 1fr;
    }
    .einsatzliste .zeit {
      grid-column: 1 / -1;
    }
  }
  .einsatzliste .zeit {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--tinte2);
    white-space: nowrap;
  }
  .einsatzliste .art {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 6px;
    color: #fff;
  }
  .einsatzliste .art.thl { background: #2b54d4; }
  .einsatzliste .art.brand { background: #e10600; }
  .einsatzliste .art.sonstige { background: #b7791f; }
  .blaettern {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--linie);
  }
  .blaettern a {
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--tinte);
  }
  .blaettern a:hover {
    color: var(--rot);
  }
  .blaettern a:last-child {
    text-align: right;
  }
  .blaettern .stand {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--tinte2);
  }
</style>
