---
import { getCollection, render } from 'astro:content';
import Basis from '../../layouts/Basis.astro';

export async function getStaticPaths() {
  const berichte = await getCollection('berichte');
  return berichte.map((b) => ({ params: { slug: b.id }, props: { bericht: b } }));
}

const { bericht } = Astro.props;
const { Content } = await render(bericht);
const d = bericht.data;
const monatsformat = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' });
---

<Basis titel={`${d.titel} – Feuerwehr Weiden`}>
  <main>
    <section class="subhero">
      <div
        class="bild"
        style={`background-image:url(${d.titelbild ?? '/bilder/header/feldbrand.jpg'});background-position:center 30%`}
      >
      </div>
      <div class="duster"></div>
      <div class="inhalt">
        <div class="wrap">
          <a class="zurueck" href="/berichte/">← Alle Berichte</a>
          <span class="eyebrow">{d.ressort} · {monatsformat.format(d.datum)}</span>
          <h1 class="display" style="max-width:18ch">{d.titel}</h1>
        </div>
      </div>
    </section>

    <section>
      <div class="artikel" style="padding-top:clamp(44px,6vw,72px);padding-bottom:clamp(72px,9vw,120px)">
        {d.kurz && <p class="artikel-lead reveal">{d.kurz}</p>}

        {
          d.stats.length > 0 && (
            <div class="artikel-stats reveal">
              {d.stats.map((s) => (
                <div class="astat">
                  <b>{s.wert}</b>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          )
        }

        <div class="artikeltext">
          <Content />
        </div>

        <div class="artikel-ende reveal">
          <a class="zurueck" href="/berichte/" style="margin:0">← Alle Berichte</a>
          <a class="btn btn-rot" href="/#mitmachen">Lust bekommen? Mach mit!</a>
        </div>
      </div>
    </section>
  </main>
</Basis>
