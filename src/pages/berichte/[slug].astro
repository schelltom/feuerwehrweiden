---
import { getCollection, render } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Slideshow from '../../components/Slideshow.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';

export async function getStaticPaths() {
  const berichte = await getCollection('berichte');
  return berichte.map((b) => ({ params: { slug: b.id }, props: { bericht: b } }));
}

const { bericht } = Astro.props;
const { Content } = await render(bericht);
const d = bericht.data;

/* Einleitung nur zeigen, wenn sie nicht ohnehin der erste Satz des Textes ist */
const norm = (s: string) => s.replace(/\s+/g, ' ').trim();
const zeigeLead = !!d.kurz && !norm(bericht.body ?? '').startsWith(norm(d.kurz).slice(0, 40));
const monatsformat = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' });
---

<Basis titel={`${d.titel} – Feuerwehr Weiden`} beschreibung={d.kurz} bild={d.titelbild}>
  <main>
    <Seitenkopf
      titel={d.titel}
      krumen={[
        { name: 'Start', href: '/' },
        { name: 'Berichte', href: '/berichte/' },
        { name: `${d.ressort} · ${monatsformat.format(d.datum)}` },
      ]}
      bild={d.titelbild}
    />

    <section>
      <div class="artikel" style="padding-top:clamp(44px,6vw,72px);padding-bottom:clamp(72px,9vw,120px)">
        {zeigeLead && <p class="artikel-lead reveal">{d.kurz}</p>}

        {
          d.stats.length > 0 && (
            <div class="artikel-stats reveal">
              {d.stats.map((s) => (
                <div class="astat">
                  <b>{s.wert}</b>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          )
        }

        <div class="artikeltext">
          <Content />
        </div>

        {
          d.galerie.length > 0 && (
            <div class="artikel-galerie">
              <span class="eyebrow">Bilder</span>
              <Slideshow bilder={d.galerie} titel={d.titel} />
            </div>
          )
        }

        <div class="artikel-ende reveal">
          <a class="zurueck" href="/berichte/" style="margin:0">← Alle Berichte</a>
          <a class="btn btn-rot" href="/feuerwehr/ueber-uns/mitglied-werden/">Lust bekommen? Mach mit!</a>
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .artikel-galerie {
    margin-top: clamp(32px, 5vw, 52px);
  }
  .artikel-galerie .eyebrow {
    display: block;
    margin-bottom: 12px;
  }
</style>
