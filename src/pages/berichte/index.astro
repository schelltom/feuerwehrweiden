---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';

const berichte = (await getCollection('berichte')).sort(
  (a, b) => b.data.datum.getTime() - a.data.datum.getTime()
);
const datumsformat = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<Basis titel="Aktuelles – Feuerwehr Weiden">
  <main>
    <section class="subhero" style="min-height:44svh">
      <div class="bild" style="background-image:url(/bilder/header/drohne.jpg)"></div>
      <div class="duster"></div>
      <div class="inhalt">
        <div class="wrap">
          <span class="eyebrow">Aktuelles</span>
          <h1 class="display">Neues aus der Wehr</h1>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px);max-width:860px">
        <ul class="news">
          {
            berichte.map((b) => (
              <li>
                <span class="meta">
                  {datumsformat.format(b.data.datum)}
                  <b>{b.data.ressort}</b>
                </span>
                <h3>
                  <a href={`/berichte/${b.id}/`}>{b.data.titel}</a>
                </h3>
                {b.data.kurz && <p style="margin:8px 0 0;color:var(--tinte2);font-size:.95rem">{b.data.kurz}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Basis>
