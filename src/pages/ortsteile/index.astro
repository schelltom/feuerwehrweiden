---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';

const orte = (await getCollection('seiten'))
  .filter((s) => s.data.bereich === 'ortsteile' && !s.data.entwurf)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<Basis titel="Ortsteile – Feuerwehr Weiden">
  <main>
    <Seitenkopf titel="Unsere Ortsteilwehren" krumen={[{ name: 'Start', href: '/' }, { name: 'Schnelle Hilfe in der Fläche' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        <p class="intro reveal">
          Neben der Hauptfeuerwache sichern fünf Ortsteilfeuerwehren den Brandschutz und die
          technische Hilfe in den Weidener Ortsteilen.
        </p>
        <div class="orteraster">
          {
            orte.map((o) => (
              <a
                class="ortkarte reveal"
                href={o.data.extern ?? `/ortsteile/${o.id}/`}
                target={o.data.extern ? '_blank' : undefined}
                rel={o.data.extern ? 'noopener' : undefined}
              >
                {o.data.kartenmotiv === 'geraetehaus' ? (
                  <span class="motiv" aria-hidden="true">
                    <svg viewBox="0 0 200 112" class="geraetehaus">
                      <!-- Halle mit drei Toren und Schlauchturm -->
                      <rect x="12" y="40" width="126" height="62" fill="#4A505E" />
                      <polygon points="6,40 144,40 138,27 12,27" fill="#3A3F4C" />
                      <rect x="146" y="12" width="34" height="90" fill="#4A505E" />
                      <polygon points="142,12 184,12 180,4 146,4" fill="#3A3F4C" />
                      <rect x="158" y="22" width="10" height="16" rx="2" fill="#E9EBF1" />
                      <rect x="158" y="48" width="10" height="16" rx="2" fill="#E9EBF1" />
                      <rect x="24" y="56" width="26" height="46" rx="2" fill="#E10600" />
                      <rect x="62" y="56" width="26" height="46" rx="2" fill="#E10600" />
                      <rect x="100" y="56" width="26" height="46" rx="2" fill="#E10600" />
                      <g stroke="#B00500" stroke-width="1.6">
                        <path d="M24,68 h26 M24,80 h26 M24,92 h26" />
                        <path d="M62,68 h26 M62,80 h26 M62,92 h26" />
                        <path d="M100,68 h26 M100,80 h26 M100,92 h26" />
                      </g>
                      <rect x="4" y="102" width="188" height="4" rx="2" fill="#3A3F4C" />
                    </svg>
                  </span>
                ) : (o.data.kartenbild ?? o.data.titelbild) ? (
                  <img class="foto" src={o.data.kartenbild ?? o.data.titelbild} alt={o.data.titel} loading="lazy" />
                ) : (
                  <span class="ohne" aria-hidden="true" />
                )}
                {o.data.kartenmotiv !== 'geraetehaus' && <span class="schatten" aria-hidden="true" />}
                {o.data.wappen && <img class="wappen" src={o.data.wappen} alt="" loading="lazy" />}
                <span class="txt">
                  {o.data.kurz && <em>{o.data.kurz}</em>}
                  <b>{o.data.titel}{o.data.extern && ' ↗'}</b>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .orteraster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 820px) {
    .orteraster {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .orteraster {
      grid-template-columns: 1fr;
    }
  }
  .ortkarte {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    aspect-ratio: 16 / 10;
    background: var(--dunkel2);
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ortkarte:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 48px rgba(20, 22, 28, 0.22);
  }
  .ortkarte .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .ortkarte:hover .foto {
    transform: scale(1.07);
  }
  .ortkarte .motiv {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(420px 220px at 50% 115%, rgba(225, 6, 0, 0.12), transparent 65%),
      linear-gradient(165deg, #f2f3f7, #d9dce4);
  }
  .ortkarte .geraetehaus {
    width: 52%;
    max-width: 220px;
    margin-bottom: 30px;
    filter: drop-shadow(0 6px 14px rgba(20, 22, 28, 0.25));
    transition: transform 0.3s ease;
  }
  .ortkarte:hover .geraetehaus {
    transform: translateY(-4px) scale(1.04);
  }
  .ortkarte:has(.motiv) .txt b {
    color: var(--tinte);
  }
  .ortkarte:has(.motiv) .txt em {
    color: var(--tinte2);
  }
  .ortkarte .ohne {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(400px 200px at 80% 0%, rgba(225, 6, 0, 0.25), transparent 65%),
      var(--dunkel2);
  }
  .ortkarte .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.9) 0%, rgba(10, 12, 16, 0.2) 50%, transparent 75%);
  }
  .ortkarte .wappen {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 52px;
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5));
  }
  .ortkarte .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px;
    display: grid;
    gap: 3px;
  }
  .ortkarte .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .ortkarte .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1;
  }
</style>
