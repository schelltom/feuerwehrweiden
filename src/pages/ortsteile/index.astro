---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';

const orte = (await getCollection('seiten'))
  .filter((s) => s.data.bereich === 'ortsteile')
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<Basis titel="Ortsteile – Feuerwehr Weiden">
  <main>
    <section class="subhero" style="min-height:44svh">
      <div class="bild" style="background-image:url(/bilder/header/feldbrand.jpg)"></div>
      <div class="duster"></div>
      <div class="inhalt">
        <div class="wrap">
          <span class="eyebrow">Schnelle Hilfe in der Fläche</span>
          <h1 class="display">Unsere Ortsteilwehren</h1>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        <p class="intro reveal">
          Neben der Hauptfeuerwache sichern fünf Ortsteilfeuerwehren den Brandschutz und die
          technische Hilfe in den Weidener Ortsteilen.
        </p>
        <div class="orteraster">
          {
            orte.map((o) => (
              <a
                class="ortkarte reveal"
                href={o.data.extern ?? `/ortsteile/${o.id}/`}
                target={o.data.extern ? '_blank' : undefined}
                rel={o.data.extern ? 'noopener' : undefined}
              >
                {o.data.titelbild ? (
                  <img class="foto" src={o.data.titelbild} alt={o.data.titel} loading="lazy" />
                ) : (
                  <span class="ohne" aria-hidden="true" />
                )}
                <span class="schatten" aria-hidden="true"></span>
                {o.data.wappen && <img class="wappen" src={o.data.wappen} alt="" loading="lazy" />}
                <span class="txt">
                  {o.data.kurz && <em>{o.data.kurz}</em>}
                  <b>{o.data.titel}{o.data.extern && ' ↗'}</b>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .orteraster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 820px) {
    .orteraster {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .orteraster {
      grid-template-columns: 1fr;
    }
  }
  .ortkarte {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    aspect-ratio: 16 / 10;
    background: var(--dunkel2);
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ortkarte:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 48px rgba(20, 22, 28, 0.22);
  }
  .ortkarte .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .ortkarte:hover .foto {
    transform: scale(1.07);
  }
  .ortkarte .ohne {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(400px 200px at 80% 0%, rgba(225, 6, 0, 0.25), transparent 65%),
      var(--dunkel2);
  }
  .ortkarte .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.9) 0%, rgba(10, 12, 16, 0.2) 50%, transparent 75%);
  }
  .ortkarte .wappen {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 52px;
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5));
  }
  .ortkarte .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px;
    display: grid;
    gap: 3px;
  }
  .ortkarte .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .ortkarte .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1;
  }
</style>
