---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';

const seiten = (await getCollection('seiten')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
const ueberUns = seiten.filter((s) => s.data.bereich === 'ueber-uns');

/** Statt Porträt: Helm mit Führungskennzeichnung (Anzahl roter Streifen) */
const helme: Record<string, number> = { stadtbrandrat: 4, stadtbrandinspektor: 3 };
const einheiten = seiten.filter((s) => s.data.bereich === 'einheiten');
---

<Basis titel="Feuerwehr – Feuerwehr Weiden">
  <main>
    <Seitenkopf titel="Unsere Feuerwehr" krumen={[{ name: 'Start', href: '/' }, { name: 'Über uns · Einheiten' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        <div class="gruppe">
          <span class="eyebrow">Verein &amp; Führung</span>
          <h2 class="titel display reveal" style="font-size:clamp(1.9rem,4vw,2.8rem)">Über uns</h2>
          <div class="seitenraster">
            {
              ueberUns.map((s) => (
                <a
                  class:list={['seitenkarte', 'reveal', { grafik: helme[s.id] || s.id === 'vorstandschaft' }]}
                  href={`/feuerwehr/${s.data.bereich}/${s.id}/`}
                >
                  {s.id === 'vorstandschaft' ? (
                    <span class="grafikfeld" aria-hidden="true">
                      <svg viewBox="0 0 140 78" class="koepfe">
                        <!-- Vorstand als Gruppe: Silhouetten, Mitte hervorgehoben -->
                        <g fill="#4A505E">
                          <circle cx="38" cy="26" r="13" />
                          <path d="M18,78 C18,54 27,45 38,45 C49,45 58,54 58,78 Z" />
                        </g>
                        <g fill="#6E7480">
                          <circle cx="102" cy="26" r="13" />
                          <path d="M82,78 C82,54 91,45 102,45 C113,45 122,54 122,78 Z" />
                        </g>
                        <g fill="#C9CDD6">
                          <circle cx="70" cy="22" r="15" />
                          <path d="M47,78 C47,52 57,42 70,42 C83,42 93,52 93,78 Z" />
                        </g>
                      </svg>
                    </span>
                  ) : helme[s.id] ? (
                    <span class="helmfeld" aria-hidden="true">
                      <svg viewBox="0 0 100 96" class="helm">
                        <!-- Bayerischer DIN-Helm (Frontansicht, nach Vorbild der amtlichen
                             Funktionsabzeichen): Nackenschutz, ausgestellter Rand,
                             Reflexstreifen, rote Balken = Führungskennzeichnung -->
                        <path
                          d="M15,63 C11,77 25,90 50,90 C75,90 89,77 85,63 Z"
                          fill="#242933"
                          stroke="#4A505E"
                          stroke-width="1.5"
                        />
                        <path d="M20,66 C30,80 62,84 80,68" fill="none" stroke="#4A505E" stroke-width="2" />
                        <path d="M80,66 C70,80 38,84 20,68" fill="none" stroke="#4A505E" stroke-width="2" />
                        <path
                          d="M50,5 C29,5 15,20 14,40 L14,46 C11,52 8,58 6,63 Q50,70 94,63 C92,58 89,52 86,46 L86,40 C85,20 71,5 50,5 Z"
                          fill="#EDE94F"
                          stroke="#23261C"
                          stroke-width="2"
                        />
                        <path d="M13,45 Q50,51 87,45 L87,52 Q50,58 13,52 Z" fill="#FAFBFD" />
                        <circle cx="16" cy="42" r="2" fill="#EDE94F" stroke="#8A8F55" stroke-width="1.2" />
                        <circle cx="84" cy="42" r="2" fill="#EDE94F" stroke="#8A8F55" stroke-width="1.2" />
                        {Array.from({ length: helme[s.id] }, (_, i) => (
                          <rect
                            x={50 - (helme[s.id] * 5.5 + (helme[s.id] - 1) * 3.5) / 2 + i * 9}
                            y="24"
                            width="5.5"
                            height="18"
                            fill="#E10600"
                          />
                        ))}
                      </svg>
                    </span>
                  ) : (s.data.kartenbild ?? s.data.titelbild) ? (
                    <img src={s.data.kartenbild ?? s.data.titelbild} alt={s.data.titel} loading="lazy" />
                  ) : (
                    <span class="ohne" aria-hidden="true" />
                  )}
                  <span class="schatten" aria-hidden="true"></span>
                  <span class="txt">
                    {s.data.kurz && <em>{s.data.kurz}</em>}
                    <b>{s.data.titel}</b>
                  </span>
                </a>
              ))
            }
            <a class="seitenkarte reveal grafik" href="/feuerwehr/ueber-uns/kalender/">
              <span class="grafikfeld" aria-hidden="true">
                <svg viewBox="0 0 140 78" class="koepfe">
                  <!-- Kalenderblatt als Line-Art, Übungstag in Rot markiert -->
                  <rect x="42" y="12" width="56" height="56" rx="6" fill="#1B1F27" stroke="#C9CDD6" stroke-width="2" />
                  <path d="M42,18 a6,6 0 0 1 6,-6 h44 a6,6 0 0 1 6,6 v10 h-56 z" fill="#E10600" />
                  <rect x="54" y="6" width="4.5" height="12" rx="2" fill="#8A8F9C" />
                  <rect x="82" y="6" width="4.5" height="12" rx="2" fill="#8A8F9C" />
                  {Array.from({ length: 3 }, (_, z) =>
                    Array.from({ length: 4 }, (_, s2) => (
                      <rect x={50 + s2 * 11} y={35 + z * 10} width="7" height="6" rx="1.5" fill={z === 1 && s2 === 2 ? '#E10600' : '#4A505E'} />
                    ))
                  )}
                </svg>
              </span>
              <span class="schatten" aria-hidden="true"></span>
              <span class="txt">
                <em>Übungen &amp; Veranstaltungen</em>
                <b>Kalender</b>
              </span>
            </a>
          </div>
        </div>

        <div class="gruppe" style="margin-bottom:0">
          <span class="eyebrow">Vom Löschzug bis zur Drohne</span>
          <h2 class="titel display reveal" style="font-size:clamp(1.9rem,4vw,2.8rem)">Einheiten</h2>
          <div class="seitenraster einheitenraster">
            {
              einheiten.map((s) => (
                <a class="seitenkarte reveal" href={`/feuerwehr/${s.data.bereich}/${s.id}/`}>
                  {(s.data.kartenbild ?? s.data.titelbild) ? (
                    <img src={s.data.kartenbild ?? s.data.titelbild} alt={s.data.titel} loading="lazy" />
                  ) : (
                    <span class="ohne" aria-hidden="true" />
                  )}
                  <span class="schatten" aria-hidden="true"></span>
                  <span class="txt">
                    {s.data.kurz && <em>{s.data.kurz}</em>}
                    <b>{s.data.titel}</b>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .gruppe {
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .gruppe .titel {
    margin-bottom: 26px;
  }
  .seitenraster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  /* Einheiten: Zeile 1+2 je zwei breite Karten, Zeile 3 drei Karten */
  .einheitenraster {
    grid-template-columns: repeat(6, 1fr);
  }
  .einheitenraster > :nth-child(-n + 4) {
    grid-column: span 3;
  }
  .einheitenraster > :nth-child(n + 5) {
    grid-column: span 2;
  }
  @media (max-width: 820px) {
    .seitenraster {
      grid-template-columns: repeat(2, 1fr);
    }
    .einheitenraster > * {
      grid-column: span 1 !important;
    }
    .einheitenraster {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .seitenraster {
      grid-template-columns: 1fr;
    }
  }
  .seitenkarte {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    aspect-ratio: 16 / 9;
    background: var(--dunkel2);
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .seitenkarte:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 48px rgba(20, 22, 28, 0.22);
  }
  .seitenkarte img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .seitenkarte:hover img {
    transform: scale(1.07);
  }
  .seitenkarte .helmfeld,
  .seitenkarte .grafikfeld {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(420px 240px at 82% -12%, rgba(225, 6, 0, 0.3), transparent 65%),
      repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.025) 0 18px, transparent 18px 36px),
      var(--dunkel2);
  }
  .seitenkarte .koepfe {
    width: 40%;
    max-width: 175px;
    margin-bottom: 22px;
    filter: drop-shadow(0 6px 14px rgba(20, 22, 28, 0.25));
    transition: transform 0.3s ease;
  }
  .seitenkarte:hover .koepfe {
    transform: translateY(-4px) scale(1.05);
  }
  .seitenkarte .helm {
    width: 42%;
    max-width: 190px;
    margin-bottom: 26px;
    filter: drop-shadow(0 6px 14px rgba(20, 22, 28, 0.3));
    transition: transform 0.3s ease;
  }
  .seitenkarte:hover .helm {
    transform: translateY(-4px) scale(1.05);
  }
  .seitenkarte .ohne {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(400px 200px at 80% 0%, rgba(225, 6, 0, 0.25), transparent 65%),
      var(--dunkel2);
  }
  /* Kräftigerer Verlauf: weiße Beschriftung bleibt auch auf hellen Fotos lesbar */
  .seitenkarte .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.94) 0%, rgba(10, 12, 16, 0.42) 46%, transparent 78%);
  }
  .seitenkarte .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px;
    display: grid;
    gap: 3px;
  }
  .seitenkarte .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d6d9e0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
  }
  .seitenkarte .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
  }
  /* Grafik-Karten (Helme, Vorstand, Kalender): dezenter Verlauf reicht */
  .seitenkarte.grafik .schatten {
    background: linear-gradient(to top, rgba(10, 12, 16, 0.7) 0%, transparent 55%);
  }
</style>
