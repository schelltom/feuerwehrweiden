---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';

const seiten = (await getCollection('seiten')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
const ueberUns = seiten.filter((s) => s.data.bereich === 'ueber-uns');

/** Statt Porträt: Helm mit Führungskennzeichnung (Anzahl roter Streifen) */
const helme: Record<string, number> = { stadtbrandrat: 4, stadtbrandinspektor: 3 };
const einheiten = seiten.filter((s) => s.data.bereich === 'einheiten');
---

<Basis titel="Feuerwehr – Feuerwehr Weiden">
  <main>
    <Seitenkopf titel="Unsere Feuerwehr" krumen={[{ name: 'Start', href: '/' }, { name: 'Über uns · Einheiten' }]} />

    <section>
      <div class="wrap" style="padding-top:clamp(44px,6vw,72px)">
        <div class="gruppe">
          <span class="eyebrow">Verein &amp; Führung</span>
          <h2 class="titel display reveal" style="font-size:clamp(1.9rem,4vw,2.8rem)">Über uns</h2>
          <div class="seitenraster">
            {
              ueberUns.map((s) => (
                <a
                  class:list={['seitenkarte', 'reveal', { hell: helme[s.id] || s.id === 'vorstandschaft' }]}
                  href={`/feuerwehr/${s.data.bereich}/${s.id}/`}
                >
                  {s.id === 'vorstandschaft' ? (
                    <span class="grafikfeld" aria-hidden="true">
                      <svg viewBox="0 0 140 78" class="koepfe">
                        <!-- schattierte Köpfe: Vorstand als Gruppe -->
                        <g fill="#C9CDD6">
                          <circle cx="38" cy="26" r="13" />
                          <path d="M18,78 C18,54 27,45 38,45 C49,45 58,54 58,78 Z" />
                        </g>
                        <g fill="#9AA0AD">
                          <circle cx="102" cy="26" r="13" />
                          <path d="M82,78 C82,54 91,45 102,45 C113,45 122,54 122,78 Z" />
                        </g>
                        <g fill="#4A505E">
                          <circle cx="70" cy="22" r="15" />
                          <path d="M47,78 C47,52 57,42 70,42 C83,42 93,52 93,78 Z" />
                        </g>
                        <rect x="47" y="14" width="46" height="4.5" rx="2" fill="#E10600" opacity="0" />
                      </svg>
                    </span>
                  ) : helme[s.id] ? (
                    <span class="helmfeld" aria-hidden="true">
                      <svg viewBox="0 0 100 82" class="helm">
                        <!-- Bayerischer Feuerwehrhelm, Frontansicht -->
                        <path
                          d="M50,6 C27,6 10,25 10,50 C10,60 9,68 12,72 L88,72 C91,68 90,60 90,50 C90,25 73,6 50,6 Z"
                          fill="#E4E9AE"
                          stroke="#3A3F35"
                          stroke-width="2"
                        />
                        <rect x="9" y="50" width="82" height="9" fill="#D6D9E0" stroke="#9AA0AD" stroke-width="1.2" />
                        {Array.from({ length: helme[s.id] }, (_, i) => (
                          <rect
                            x={50 - (helme[s.id] * 5.5 + (helme[s.id] - 1) * 4) / 2 + i * 9.5}
                            y="22"
                            width="5.5"
                            height="18"
                            fill="#E10600"
                          />
                        ))}
                      </svg>
                    </span>
                  ) : (s.data.kartenbild ?? s.data.titelbild) ? (
                    <img src={s.data.kartenbild ?? s.data.titelbild} alt={s.data.titel} loading="lazy" />
                  ) : (
                    <span class="ohne" aria-hidden="true" />
                  )}
                  <span class="schatten" aria-hidden="true"></span>
                  <span class="txt">
                    {s.data.kurz && <em>{s.data.kurz}</em>}
                    <b>{s.data.titel}</b>
                  </span>
                </a>
              ))
            }
            <a class="seitenkarte reveal hell" href="/feuerwehr/ueber-uns/kalender/">
              <span class="grafikfeld" aria-hidden="true">
                <svg viewBox="0 0 140 78" class="koepfe">
                  <!-- Kalenderblatt -->
                  <rect x="42" y="12" width="56" height="56" rx="6" fill="#fff" stroke="#9AA0AD" stroke-width="2" />
                  <path d="M42,18 a6,6 0 0 1 6,-6 h44 a6,6 0 0 1 6,6 v10 h-56 z" fill="#E10600" />
                  <rect x="54" y="6" width="4.5" height="12" rx="2" fill="#4A505E" />
                  <rect x="82" y="6" width="4.5" height="12" rx="2" fill="#4A505E" />
                  {Array.from({ length: 3 }, (_, z) =>
                    Array.from({ length: 4 }, (_, s2) => (
                      <rect x={50 + s2 * 11} y={35 + z * 10} width="7" height="6" rx="1.5" fill={z === 1 && s2 === 2 ? '#E10600' : '#C9CDD6'} />
                    ))
                  )}
                </svg>
              </span>
              <span class="schatten" aria-hidden="true"></span>
              <span class="txt">
                <em>Übungen &amp; Veranstaltungen</em>
                <b>Kalender</b>
              </span>
            </a>
          </div>
        </div>

        <div class="gruppe" style="margin-bottom:0">
          <span class="eyebrow">Vom Löschzug bis zur Drohne</span>
          <h2 class="titel display reveal" style="font-size:clamp(1.9rem,4vw,2.8rem)">Einheiten</h2>
          <div class="seitenraster einheitenraster">
            {
              einheiten.map((s) => (
                <a class="seitenkarte reveal" href={`/feuerwehr/${s.data.bereich}/${s.id}/`}>
                  {(s.data.kartenbild ?? s.data.titelbild) ? (
                    <img src={s.data.kartenbild ?? s.data.titelbild} alt={s.data.titel} loading="lazy" />
                  ) : (
                    <span class="ohne" aria-hidden="true" />
                  )}
                  <span class="schatten" aria-hidden="true"></span>
                  <span class="txt">
                    {s.data.kurz && <em>{s.data.kurz}</em>}
                    <b>{s.data.titel}</b>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Basis>

<style>
  .gruppe {
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .gruppe .titel {
    margin-bottom: 26px;
  }
  .seitenraster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  /* Einheiten: Zeile 1+2 je zwei breite Karten, Zeile 3 drei Karten */
  .einheitenraster {
    grid-template-columns: repeat(6, 1fr);
  }
  .einheitenraster > :nth-child(-n + 4) {
    grid-column: span 3;
  }
  .einheitenraster > :nth-child(n + 5) {
    grid-column: span 2;
  }
  @media (max-width: 820px) {
    .seitenraster {
      grid-template-columns: repeat(2, 1fr);
    }
    .einheitenraster > * {
      grid-column: span 1 !important;
    }
    .einheitenraster {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .seitenraster {
      grid-template-columns: 1fr;
    }
  }
  .seitenkarte {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #fff;
    aspect-ratio: 16 / 9;
    background: var(--dunkel2);
    box-shadow: 0 4px 18px rgba(20, 22, 28, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .seitenkarte:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 48px rgba(20, 22, 28, 0.22);
  }
  .seitenkarte img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .seitenkarte:hover img {
    transform: scale(1.07);
  }
  .seitenkarte .helmfeld,
  .seitenkarte .grafikfeld {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(420px 220px at 50% 115%, rgba(225, 6, 0, 0.12), transparent 65%),
      linear-gradient(165deg, #f2f3f7, #d9dce4);
  }
  .seitenkarte .koepfe {
    width: 40%;
    max-width: 175px;
    margin-bottom: 22px;
    filter: drop-shadow(0 6px 14px rgba(20, 22, 28, 0.25));
    transition: transform 0.3s ease;
  }
  .seitenkarte:hover .koepfe {
    transform: translateY(-4px) scale(1.05);
  }
  .seitenkarte .helm {
    width: 42%;
    max-width: 190px;
    margin-bottom: 26px;
    filter: drop-shadow(0 6px 14px rgba(20, 22, 28, 0.3));
    transition: transform 0.3s ease;
  }
  .seitenkarte:hover .helm {
    transform: translateY(-4px) scale(1.05);
  }
  .seitenkarte .ohne {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(400px 200px at 80% 0%, rgba(225, 6, 0, 0.25), transparent 65%),
      var(--dunkel2);
  }
  .seitenkarte .schatten {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.88) 0%, rgba(10, 12, 16, 0.2) 50%, transparent 75%);
  }
  .seitenkarte .txt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px;
    display: grid;
    gap: 3px;
  }
  .seitenkarte .txt em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .seitenkarte .txt b {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1;
  }
  /* Helle Grafik-Karten: kein dunkler Verlauf, dunkle Beschriftung */
  .seitenkarte.hell {
    background: linear-gradient(165deg, #f2f3f7, #d9dce4);
  }
  .seitenkarte.hell .schatten {
    display: none;
  }
  .seitenkarte.hell .txt b {
    color: var(--tinte);
  }
  .seitenkarte.hell .txt em {
    color: var(--tinte2);
  }
</style>
