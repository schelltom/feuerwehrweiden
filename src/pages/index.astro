---
import { getCollection } from 'astro:content';
import { ladeEinsaetze } from '../lib/einsaetze';
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import Einsatzmonitor from '../components/Einsatzmonitor.astro';
import Bereiche from '../components/Bereiche.astro';
import Fahrzeughalle from '../components/Fahrzeughalle.astro';

const einsaetze = await ladeEinsaetze();

const berichte = (await getCollection('berichte'))
  .sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime())
  .slice(0, 5);

const heute = new Date();
heute.setHours(0, 0, 0, 0);
const termine = (await getCollection('termine'))
  .map((t) => t.data)
  .filter((t) => t.datum >= heute)
  .sort((a, b) => a.datum.getTime() - b.datum.getTime())
  .slice(0, 5);

const fahrzeuge = (await getCollection('fahrzeuge'))
  .filter((f) => f.data.inHalle)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
  .map((f) => ({
    id: f.id,
    name: f.data.name,
    typ: f.data.typ,
    funkruf: f.data.funkruf,
    bild: f.data.bild,
  }));

const monate = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const datumsformat = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<Basis mitAlarm={true}>
  <main>
    <Hero ticker={einsaetze.slice(0, 4)} />

    <section id="aktuelles">
      <div class="wrap" style="padding-top:clamp(40px,5vw,64px)">
        <div class="zweispalt">
          <div>
            <span class="eyebrow">Aktuelles</span>
            <h2 class="titel display reveal">Neues aus der Wehr</h2>
            <ul class="news reveal">
              {
                berichte.map((b) => (
                  <li>
                    <a class="thumb" href={`/berichte/${b.id}/`} tabindex="-1" aria-hidden="true">
                      {b.data.titelbild ? (
                        <img src={b.data.titelbild} alt="" loading="lazy" />
                      ) : (
                        <span class="ohne">
                          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c1 4-3 5-3 9a3 3 0 0 0 6 0c0-2-1-3-1-3s4 1 4 5a6 6 0 0 1-12 0c0-6 5-7 6-11z"/></svg>
                        </span>
                      )}
                    </a>
                    <div class="ntext">
                      <span class="meta">
                        {datumsformat.format(b.data.datum)}
                        <b>{b.data.ressort}</b>
                      </span>
                      <h3>
                        <a href={`/berichte/${b.id}/`}>{b.data.titel}</a>
                      </h3>
                    </div>
                  </li>
                ))
              }
            </ul>
            <p style="margin-top:18px">
              <a href="/berichte/" style="font-family:var(--mono);font-size:.8rem;letter-spacing:.12em;color:var(--tinte2);text-decoration:none;border-bottom:1px solid var(--rot)">Alle Berichte ansehen →</a>
            </p>
          </div>
          <div style="display:grid;gap:38px;align-content:start">
            <Einsatzmonitor einsaetze={einsaetze.slice(0, 5)} kompakt />
            <div>
              <span class="eyebrow">Termine</span>
              <h2 class="titel display reveal" style="font-size:clamp(1.5rem,2.6vw,2rem)">Nächste Übungen</h2>
              <ul class="termine reveal">
                {
                  termine.map((t) => (
                    <li class="termin">
                      <div class="tag">
                        <b>{t.datum.getDate()}</b>
                        <span>{monate[t.datum.getMonth()]}</span>
                      </div>
                      <div class="info">
                        <b>{t.titel}</b>
                        <span>{t.von} – {t.bis}</span>
                      </div>
                    </li>
                  ))
                }
              </ul>
              <p style="margin-top:18px">
                <a href="/feuerwehr/ueber-uns/kalender/" style="font-family:var(--mono);font-size:.8rem;letter-spacing:.12em;color:var(--tinte2);text-decoration:none;border-bottom:1px solid var(--rot)">Zum Kalender →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="zahlen">
      <div class="wrap">
        <div class="zahl reveal"><b><span class="zaehler" data-ziel="10500" data-tausender>0</span></b><span>Atemschutzgeräte&shy;prüfungen im Jahr</span></div>
        <div class="zahl reveal"><b><span class="zaehler" data-ziel="24">0</span><em>/7</em></b><span>Einsatzbereit</span></div>
        <div class="zahl reveal"><b><span class="zaehler" data-ziel="30">0</span><em>+</em></b><span>Fahrzeuge &amp; Anhänger</span></div>
        <div class="zahl reveal"><b><span class="zaehler" data-ziel="1456" data-tausender>0</span></b><span>Schlauchprüfungen im Jahr</span></div>
        <div class="zahl reveal"><b><em>seit</em> <span class="zaehler" data-ziel="1861">0</span></b><span>Gegründet als Turnerfeuerwehr</span></div>
      </div>
    </section>

    <Bereiche />
    <Fahrzeughalle fahrzeuge={fahrzeuge} />

    <div class="notfall">
      <div class="wrap">
        <div class="n1">
          <b class="display">112</b>
          <span>Eine Nummer · rund um die Uhr · an 365 Tagen</span>
        </div>
        <div class="apps">
          <a href="https://www.katwarn.de/" target="_blank" rel="noopener">Warn-App KATWARN</a>
          <a href="https://www.bbk.bund.de/DE/Warnung-Vorsorge/Warn-App-NINA/warn-app-nina_node.html" target="_blank" rel="noopener">Warn-App NINA</a>
          <a href="/service/notruf/">Notruf-Checkliste</a>
        </div>
      </div>
    </div>

    <section class="mitmachen" id="mitmachen">
      <div class="wrap" style="padding-top:0">
        <span class="eyebrow">Mitmachen</span>
        <h2 class="titel display reveal">Dein Platz im Team</h2>
        <p class="intro reveal">
          Egal ob jung oder alt – in der Feuerwehr wird jede Hilfe gebraucht. Keine Vorkenntnisse
          nötig, die Ausbildung übernehmen wir.
        </p>
        <div class="karten">
          <a class="karte reveal" href="/feuerwehr/einheiten/kinderfeuerwehr/">
            <img src="/bilder/mitmachen/kinder.jpg" alt="Kinderfeuerwehr Weiden" loading="lazy" />
            <span class="pfeil" aria-hidden="true">↗</span>
            <span class="txt"><em>ab 6 Jahren</em><h3>Kinderfeuerwehr</h3><p>Spielerisch entdecken, was Feuerwehr bedeutet.</p></span>
          </a>
          <a class="karte reveal" href="/feuerwehr/einheiten/jugendfeuerwehr/">
            <img src="/bilder/mitmachen/jugend.jpg" alt="Jugendfeuerwehr Weiden" loading="lazy" />
            <span class="pfeil" aria-hidden="true">↗</span>
            <span class="txt"><em>ab 12 Jahren</em><h3>Jugendfeuerwehr</h3><p>Echte Ausbildung, echte Technik, echte Gemeinschaft.</p></span>
          </a>
          <a class="karte reveal" href="/feuerwehr/ueber-uns/mitglied-werden/">
            <img src="/bilder/mitmachen/aktive.jpg" alt="Aktive Einsatzkräfte der Feuerwehr Weiden" loading="lazy" />
            <span class="pfeil" aria-hidden="true">↗</span>
            <span class="txt"><em>ab 18 Jahren</em><h3>Aktiver Dienst</h3><p>Quereinstieg jederzeit – wir bilden dich aus.</p></span>
          </a>
        </div>
        <div class="cta reveal">
          <a class="btn btn-rot" href="#kontakt">Unverbindlich vorbeischauen</a>
        </div>
      </div>
    </section>

    <section id="standorte">
      <div class="wrap" style="padding-top:0">
        <span class="eyebrow">Standorte</span>
        <h2 class="titel display reveal" style="font-size:clamp(1.9rem,4vw,2.8rem)">Eine Wehr, sechs Standorte</h2>
        <div class="orte reveal">
          <a class="ort haupt" href="/feuerwehr/">Hauptfeuerwache</a>
          <a class="ort" href="/ortsteile/frauenricht/">Frauenricht</a>
          <a class="ort" href="/ortsteile/mallersricht/">Mallersricht</a>
          <a class="ort" href="/ortsteile/muglhof/">Muglhof</a>
          <a class="ort" href="https://ff-nk.de/" target="_blank" rel="noopener">Neunkirchen ↗</a>
          <a class="ort" href="/ortsteile/rothenstadt/">Rothenstadt</a>
        </div>
      </div>
    </section>
  </main>
</Basis>
