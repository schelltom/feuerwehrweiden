---
import '../styles/global.css';
import SkylineWeiden from '../components/SkylineWeiden.astro';

interface Props {
  titel?: string;
  beschreibung?: string;
  /** Vorschaubild für Social-Media/Open-Graph (wurzel-relativer Pfad, z.B. /bilder/…) */
  bild?: string;
  /** Alarm-Intro nur auf der Startseite abspielen */
  mitAlarm?: boolean;
}

const {
  titel = 'Freiwillige Feuerwehr Weiden i.d.OPf.',
  beschreibung = '24 Stunden – 365 Tage für Ihre Sicherheit. Die Freiwillige Feuerwehr Weiden in der Oberpfalz.',
  bild,
  mitAlarm = false,
} = Astro.props;

// Absolute URLs für Canonical und Open Graph (basieren auf `site` in astro.config.mjs).
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const vorschaubild = new URL(bild ?? '/bilder/intro-start.jpg', Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch.href} />
    <link rel="icon" href="/bilder/wappen.png" type="image/png" />
    <title>{titel}</title>

    <!-- Open Graph / Social-Media-Vorschau (Facebook, WhatsApp, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Freiwillige Feuerwehr Weiden i.d.OPf." />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch.href} />
    <meta property="og:image" content={vorschaubild.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={vorschaubild.href} />
  </head>
  <body>
    {
      mitAlarm && (
        <div class="alarmintro" aria-hidden="true">
          <div class="mix">
            <div class="kern">
              <div class="zeile1">ILS Oberpfalz-Nord · Alarmdepesche</div>
              <div class="zeile2" id="tipptext" />
              <div class="balken" />
            </div>
            <img class="mbild" src="/bilder/intro-start.jpg" alt="" />
            <b id="countzahl">3</b>
          </div>
        </div>
      )
    }

    <header class="nav" id="topnav">
      <div class="wrap">
        <span class="marke">
          <a href="/" title="Startseite mit Alarm-Intro">
            <img src="/bilder/wappen.png" alt="Wappen der Feuerwehr Weiden" width="40" height="48" />
          </a>
          <a class="name" href="/?direkt">Freiwillige Feuerwehr Weiden</a>
        </span>
        <div class="navrechts">
          <nav class="menue" id="menue" aria-label="Hauptmenü">
          <ul>
            <li><a href="/?direkt">Home</a></li>
            <li><a href="/feuerwehr/">Feuerwehr</a></li>
            <li><a href="/fuhrpark/">Fuhrpark</a></li>
            <li><a href="/ortsteile/">Ortsteile</a></li>
            <li><a href="/service/atemschutz/">Service</a></li>
            <li><a href="/admin/index.html">Login</a></li>
            <li class="wechsel">
              <a class="n112" href="tel:112">Notruf 112</a>
              <span class="navskyline" aria-hidden="true"><SkylineWeiden /></span>
            </li>
          </ul>
          </nav>
          <div class="sozial">
            <a class="fb" href="https://www.facebook.com/feuerwehrweiden/" target="_blank" rel="noopener" aria-label="Feuerwehr Weiden auf Facebook">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.4 21.9v-8.1h2.72l.41-3.16h-3.13V8.62c0-.91.25-1.53 1.56-1.53h1.67V4.26c-.29-.04-1.28-.12-2.43-.12-2.4 0-4.05 1.47-4.05 4.16v2.32H7.42v3.16h2.73v8.1h3.25z"/></svg>
            </a>
            <a class="ig" href="https://www.instagram.com/feuerwehr_weiden/" target="_blank" rel="noopener" aria-label="Feuerwehr Weiden auf Instagram">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.2" cy="6.8" r="1.3" fill="currentColor" stroke="none"></circle></svg>
            </a>
          </div>
          <button class="burger" aria-expanded="false" aria-controls="menue" id="burger">
            <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="2"/></svg>
            <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Menü</span>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <dialog id="bildpopup">
      <button id="bpZu" aria-label="Schließen">×</button>
      <button class="blaettern" id="bpZurueck" aria-label="Vorheriges Bild">‹</button>
      <img alt="" />
      <button class="blaettern" id="bpVor" aria-label="Nächstes Bild">›</button>
      <span id="bpText"></span>
    </dialog>

    <footer id="kontakt">
      <div class="wrap">
        <div class="mitlogo">
          <img class="fusslogo" src="/bilder/logo.jpg" alt="Logo der Feuerwehr Weiden: Stadtsilhouette und Wappen" width="88" height="88" loading="lazy" />
          <div>
          <h3>Freiwillige Feuerwehr Weiden i.d.OPf.</h3>
          <address class="adresse">
            Landgerichtsstraße 13 · 92637 Weiden<br />
            Telefon: <a href="tel:+499613916090">0961 / 391 609-0</a><br />
            E-Mail: <a href="mailto:info.feuerwehr@weiden.de">info.feuerwehr@weiden.de</a><br />
            Im Notfall: <strong style="color:#fff">Notruf 112</strong>
          </address>
          </div>
        </div>
        <div>
          <h3>Service</h3>
          <ul>
            <li><a href="/service/notruf/">Notruf-Checkliste</a></li>
            <li><a href="/service/atemschutz/">Atemschutzwerkstatt</a></li>
            <li><a href="/feuerwehr/ueber-uns/kalender/">Kalender</a></li>
            <li><a href="/fuhrpark/">Fuhrpark</a></li>
            <li><a href="/feuerwehr/ueber-uns/chronik/">Chronik</a></li>
          </ul>
        </div>
        <div>
          <h3>Rechtliches</h3>
          <ul>
            <li><a href="/impressum/">Impressum</a></li>
            <li><a href="/datenschutz/">Datenschutz</a></li>
          </ul>
        </div>
      </div>
      <div class="unten">
        <div class="wrap">
          <span>© 2026 FF Weiden i.d.OPf.</span>
          <span>24 Stunden · 365 Tage · für Ihre Sicherheit</span>
        </div>
      </div>
    </footer>

    <script>
      const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Alarm-Intro (nur wenn vorhanden) + Startsignal für Hero-Animationen */
      const alarm = document.querySelector<HTMLElement>('.alarmintro');
      if (alarm && !location.hash) {
        // Beim Neuladen nicht an alter Scrollposition weitermachen, sondern oben mit dem Intro starten
        history.scrollRestoration = 'manual';
        scrollTo(0, 0);
      }
      const los = () => {
        document.body.classList.add('los');
        /* Signal an den Hero: Schlauchrolle synchron zur Leitung starten */
        dispatchEvent(new CustomEvent('feuerwehr:los'));
      };
      /* Logo-Klick (?direkt): Startseite sofort zeigen – ohne Depesche, Schlauch fertig ausgerollt */
      const direkt = new URLSearchParams(location.search).has('direkt');
      if (direkt) {
        document.body.classList.add('sofort');
        history.replaceState(null, '', '/' + location.hash);
      }
      /* Sprungmarken-Links (z.B. /#mitmachen aus einem Bericht): Intro überspringen */
      if (!alarm || reduziert || direkt || location.hash) {
        alarm?.remove();
        los();
      } else {
        alarm.classList.add('laeuft');

        /* Depesche tippt oben, darunter zählt der Countdown von 5 zurück */
        const txt = 'ALARM FÜR FLORIAN WEIDEN — EINSATZ FÜR ALLE EINHEITEN';
        const ziel = document.getElementById('tipptext')!;
        let i = 0;
        const tipp = setInterval(() => {
          ziel.textContent = txt.slice(0, ++i);
          if (i >= txt.length) clearInterval(tipp);
        }, 42); // Tippgeschwindigkeit

        const zahl = document.getElementById('countzahl')!;
        let n = 3;

        /* Intro beenden – vom Countdown-Ende ODER per Klick/Tastendruck ausgelöst */
        let beendet = false;
        const fertig = () => {
          if (beendet) return;
          beendet = true;
          clearInterval(tick);
          clearInterval(tipp);
          alarm.classList.add('weg');
          los();
          setTimeout(() => alarm.remove(), 800);
        };

        const tick = setInterval(() => {
          n--;
          if (n < 1) {
            fertig();
            return;
          }
          zahl.textContent = String(n);
          zahl.classList.remove('tick');
          void (zahl as HTMLElement).offsetWidth; // Animation neu starten
          zahl.classList.add('tick');
        }, 1000);

        /* Klick (Maus/Touch) oder beliebige Taste überspringt den Countdown sofort */
        alarm.addEventListener('pointerdown', fertig);
        addEventListener('keydown', fertig);
      }

      /* Burger-Menü */
      const burger = document.getElementById('burger')!;
      const menue = document.getElementById('menue')!;
      burger.addEventListener('click', () => {
        const offen = menue.classList.toggle('offen');
        burger.setAttribute('aria-expanded', String(offen));
      });

      /* Navigation bei Scroll */
      const nav = document.getElementById('topnav')!;
      addEventListener('scroll', () => nav.classList.toggle('fest', scrollY > 40), { passive: true });

      /* Sanftes Einblenden beim Scrollen */
      const io = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) {
              e.target.classList.add('da');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* Zähler */
      const zio = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (!e.isIntersecting) continue;
            zio.unobserve(e.target);
            const el = e.target as HTMLElement;
            const ziel = Number(el.dataset.ziel);
            /* data-tausender: Anzeige mit Tausenderpunkt (10.500), Jahreszahlen bleiben ohne */
            const fmt = (n: number) => ('tausender' in el.dataset ? n.toLocaleString('de-DE') : String(n));
            if (reduziert) {
              el.textContent = fmt(ziel);
              continue;
            }
            let start: number | null = null;
            const schritt = (t: number) => {
              if (start === null) start = t;
              const p = Math.min((t - start) / 1200, 1);
              el.textContent = fmt(Math.round(ziel * (1 - Math.pow(1 - p, 3))));
              if (p < 1) requestAnimationFrame(schritt);
            };
            requestAnimationFrame(schritt);
          }
        },
        { threshold: 0.6 }
      );
      document.querySelectorAll('.zaehler').forEach((el) => zio.observe(el));

      /* Bild-Popup: jedes Inhaltsbild lässt sich per Klick vergrößern.
         Ausgenommen: Bilder in Links/Buttons, Hero-Diashow und die
         Berichts-Slideshow (hat ihren eigenen Popup) sowie Kleinkram < 90px. */
      const popup = document.getElementById('bildpopup') as HTMLDialogElement;
      const popupBild = popup.querySelector('img')!;
      const popupText = document.getElementById('bpText')!;
      document.querySelectorAll<HTMLImageElement>('main img').forEach((b) => {
        if (b.closest('a, button, .slideshow, .hero')) return;
        const pruefe = () => {
          if (b.clientWidth >= 90) b.classList.add('zoombar');
        };
        b.complete ? pruefe() : b.addEventListener('load', pruefe);
      });
      /* Blättern: alle zoombaren Bilder der Seite in Dokument-Reihenfolge */
      const zoomListe = () => [...document.querySelectorAll<HTMLImageElement>('main img.zoombar')];
      let popupIndex = -1;
      const zeigeImPopup = (bild: HTMLImageElement) => {
        popupBild.src = bild.src;
        popupBild.alt = bild.alt;
        popupText.textContent =
          bild.alt || bild.closest('figure')?.querySelector('figcaption')?.textContent || '';
      };
      document.querySelector('main')?.addEventListener('click', (e) => {
        const bild = (e.target as HTMLElement).closest('img');
        if (!bild || !bild.classList.contains('zoombar')) return;
        const liste = zoomListe();
        popupIndex = liste.indexOf(bild as HTMLImageElement);
        zeigeImPopup(bild as HTMLImageElement);
        /* Pfeile nur zeigen, wenn es auf der Seite mehr als ein Bild gibt */
        popup.querySelectorAll<HTMLButtonElement>('.blaettern').forEach((b) => (b.hidden = liste.length < 2));
        popup.showModal();
      });
      const blaettere = (schritt: number) => {
        const liste = zoomListe();
        if (liste.length < 2 || popupIndex < 0) return;
        popupIndex = (popupIndex + schritt + liste.length) % liste.length;
        zeigeImPopup(liste[popupIndex]);
      };
      document.getElementById('bpZurueck')!.addEventListener('click', () => blaettere(-1));
      document.getElementById('bpVor')!.addEventListener('click', () => blaettere(1));
      popup.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') blaettere(-1);
        if (e.key === 'ArrowRight') blaettere(1);
      });
      popup.addEventListener('click', (e) => {
        if (e.target === popup) popup.close();
      });
      document.getElementById('bpZu')!.addEventListener('click', () => popup.close());
    </script>

    <!-- Cloudflare Web Analytics (cookielos, ohne geräteübergreifendes Tracking – siehe Datenschutzerklärung) -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "45b6a3a343b345adbddef7014d229d83"}'></script>
  </body>
</html>
