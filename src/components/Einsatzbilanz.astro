---
import { ladeEinsaetze, anzahlVon } from '../lib/einsaetze';

/**
 * Einsatzbilanz-Plakat (aktuelle + letzte Woche) im Stil der
 * Social-Media-Grafik. Wochengrenzen werden beim Build berechnet –
 * die Seite baut sich bei jedem neuen Einsatz ohnehin neu.
 */
const einsaetze = await ladeEinsaetze();
const datumVon = (e: (typeof einsaetze)[number]) =>
  new Date(e.wann.getFullYear(), e.wann.getMonth(), e.wann.getDate());

const heute = new Date();
const montag = new Date(heute.getFullYear(), heute.getMonth(), heute.getDate() - ((heute.getDay() + 6) % 7));
const montagVorwoche = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() - 7);
const sonntag = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() + 6);
const sonntagVorwoche = new Date(montag.getFullYear(), montag.getMonth(), montag.getDate() - 1);

const lang = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });

const ARTEN = [
  { art: 'THL', label: 'Technische Hilfeleistung', farbe: '#2B54D4', hell: '#7D9BFF', icon: 'werkzeug' },
  { art: 'Brand', label: 'Brandeinsatz', farbe: '#B00500', hell: '#FF3B30', icon: 'flamme' },
  { art: 'Sonstige', label: 'Sonstige Einsätze', farbe: '#1A9B4E', hell: '#35C071', icon: 'personen' },
] as const;

const statsFuer = (titel: string, von: Date, bis: Date) => {
  const imZeitraum = einsaetze.filter((e) => {
    const d = datumVon(e);
    return d >= von && d <= bis;
  });
  const arten = ARTEN.map((a) => ({
    ...a,
    n: imZeitraum.filter((e) => e.art === a.art).reduce((summe, e) => summe + anzahlVon(e), 0),
  }));
  return {
    titel,
    zeitraum: `${lang.format(von)} – ${lang.format(bis)}`,
    arten,
    gesamt: arten.reduce((summe, a) => summe + a.n, 0),
  };
};

const wochen = [
  statsFuer('Aktuelle Woche', montag, sonntag),
  statsFuer('Letzte Woche', montagVorwoche, sonntagVorwoche),
];

const jahr = heute.getFullYear();
/* Im alten Kalender waren nicht alle Einsätze erfasst: offizieller Stand am
   17.07.2026 war 433, importiert wurden 376 – die Differenz kommt obendrauf.
   Ab 2027 auf 0 setzen (dann zählt nur noch der eigene Datenbestand). */
const NICHT_ERFASST = 57;
const gesamtJahr =
  einsaetze
    .filter((e) => e.wann.getFullYear() === jahr)
    .reduce((summe, e) => summe + anzahlVon(e), 0) + (jahr === 2026 ? NICHT_ERFASST : 0);

interface Props {
  /** Plakat-Kopfzeile "Einsatzbilanz der Feuerwehr Weiden" zeigen (aus, wenn die Seite selbst schon so heißt) */
  mitKopf?: boolean;
}
const { mitKopf = true } = Astro.props;

const ICONS: Record<string, string> = {
  werkzeug: 'M14 7l3 3M5 6l3-3 4 4-3 3zM12 10l7 7-3 3-7-7zM16 3l5 5',
  flamme: 'M12 3c1 4-3 5-3 9a3 3 0 0 0 6 0c0-2-1-3-1-3s4 1 4 5a6 6 0 0 1-12 0c0-6 5-7 6-11z',
  personen: 'M9 10.6a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2zM16.5 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM3.5 20c0-3.2 2.4-5 5.5-5s5.5 1.8 5.5 5M13.5 15.6c.9-.7 2-1.1 3-1.1 2.3 0 4 1.5 4 4',
};
---

<div class="plakat reveal">
  {
    mitKopf && (
      <div class="pkopf">
        <div class="ptitel">
          <b>Einsatzbilanz</b>
          <span>der <em>Feuerwehr Weiden</em></span>
        </div>
        <img class="plogo" src="/bilder/logo.jpg" alt="" width="64" height="64" loading="lazy" />
      </div>
    )
  }

  <div class="wochen">
    {
      wochen.map((w) => (
        <div class="woche">
          <div class="pille">
            <span class="kreis" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /></svg>
            </span>
            <span class="wovon">
              {w.titel} vom
              <b>{w.zeitraum}</b>
            </span>
          </div>

          <p class="vortext">In diesem Zeitraum verzeichnete die Feuerwehr Weiden insgesamt</p>

          <div class="banner">
            <b>{w.gesamt}</b>
            <span class="wort">{w.gesamt === 1 ? 'Einsatz' : 'Einsätze'}</span>
            <svg class="sirene" width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 19h14M7 19v-5a5 5 0 0 1 10 0v5M12 2.5v2M4.5 6l1.4 1.4M19.5 6l-1.4 1.4" /></svg>
          </div>

          <span class="ueberblick">
            <i aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="6" y="3.5" width="12" height="17" rx="2" /><path d="M9 3.5h6M9 9h6M9 12.5h6M9 16h4" /></svg>
            </i>
            Einsätze im Überblick
          </span>
          <ul class="arten">
            {w.arten.map((a) => (
              <li>
                <span class="ikon" style={`background:${a.farbe}`} aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d={ICONS[a.icon]} /></svg>
                </span>
                <b style={`color:${a.hell}`}>{a.n}×</b>
                <span class="label">{a.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="pfuss">
    <div class="gesamtbox">
      <span class="gb1">Gesamteinsätze {jahr}</span>
      <b>{gesamtJahr.toLocaleString('de-DE')}</b>
      <span class="gb2">Einsätze</span>
    </div>
    <div class="notrufbox">
      <b>☎ 112</b>
      <span>Wir sind für euch da.</span>
    </div>
    <div class="dankebox">
      <b>Vielen Dank an alle Einsatzkräfte</b>
      <span>für ihren unermüdlichen Einsatz und ihr Engagement zum Schutz der Bürgerinnen und Bürger.</span>
    </div>
  </div>
</div>

<style>
  .plakat {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(100deg, rgba(10, 12, 16, 0.97) 0%, rgba(10, 12, 16, 0.88) 55%, rgba(14, 17, 22, 0.62) 100%),
      url('/bilder/header/nachtbrand.jpg') right center / cover no-repeat;
    background-color: var(--dunkel);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: #fff;
    padding: clamp(22px, 3.6vw, 40px);
    box-shadow: 0 26px 60px rgba(14, 17, 22, 0.3);
  }
  .pkopf {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: clamp(18px, 3vw, 30px);
  }
  .ptitel b {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
  }
  .ptitel span {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 3vw, 2rem);
    line-height: 1.05;
  }
  .ptitel span em {
    font-style: normal;
    color: var(--rot-hell);
  }
  .pkopf img {
    flex: none;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.25), 0 6px 20px rgba(0, 0, 0, 0.55);
  }
  .wochen {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3.5vw, 44px);
    border-top: 3px solid var(--rot);
    padding-top: clamp(18px, 3vw, 26px);
  }
  @media (max-width: 720px) {
    .wochen {
      grid-template-columns: 1fr;
    }
  }
  .pille {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--rot);
    border-radius: 999px;
    padding: 7px 20px 7px 8px;
  }
  .pille .kreis {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: var(--rot-tief);
    display: grid;
    place-content: center;
  }
  .pille .wovon {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .pille .wovon b {
    display: block;
    font-family: var(--display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    font-style: italic;
  }
  .vortext {
    color: var(--silber);
    font-size: 0.86rem;
    margin: 16px 0 12px;
    max-width: 34ch;
  }
  .banner {
    background: linear-gradient(115deg, var(--rot-tief), var(--rot) 70%);
    transform: skewX(-5deg);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 22px;
    margin: 0 4px 20px 0;
  }
  .banner > * {
    transform: skewX(5deg);
  }
  .banner b {
    font-family: var(--display);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(3rem, 6vw, 4.2rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .banner .wort {
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    letter-spacing: 0.05em;
    flex: 1;
  }
  .banner .sirene {
    flex: none;
    opacity: 0.9;
  }
  .ueberblick {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
  }
  .ueberblick i {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
    background: var(--rot);
    display: grid;
    place-content: center;
  }
  .arten {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .arten li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.14);
  }
  .arten li:last-child {
    border-bottom: 0;
  }
  .arten .ikon {
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-content: center;
  }
  .arten b {
    font-family: var(--display);
    font-weight: 700;
    font-style: italic;
    font-size: 1.35rem;
    min-width: 2.4ch;
    font-variant-numeric: tabular-nums;
  }
  .arten .label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }
  .pfuss {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: clamp(18px, 3vw, 36px);
    align-items: center;
    margin-top: clamp(22px, 3.5vw, 32px);
  }
  @media (max-width: 820px) {
    .pfuss {
      grid-template-columns: 1fr;
    }
  }
  .gesamtbox {
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 14px 22px;
    text-align: center;
  }
  .gesamtbox .gb1 {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    padding-bottom: 6px;
    margin-bottom: 8px;
  }
  .gesamtbox b {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--rot-hell);
    letter-spacing: 0.14em;
  }
  .gesamtbox .gb2 {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  .notrufbox {
    text-align: center;
  }
  .notrufbox b {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;
  }
  .notrufbox span {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silber);
  }
  .dankebox b {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-style: italic;
    color: var(--rot-hell);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .dankebox span {
    color: var(--silber);
    font-size: 0.85rem;
    display: block;
    max-width: 40ch;
  }
</style>
