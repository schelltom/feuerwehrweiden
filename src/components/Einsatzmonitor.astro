---
interface Einsatz {
  wann: Date;
  datum: string;
  zeit: string;
  stichwort: string;
  art: 'THL' | 'Brand' | 'Sonstige';
}

interface Props {
  einsaetze: Einsatz[];
  /** Kompakte Darstellung für schmale Spalten */
  kompakt?: boolean;
}

const { einsaetze, kompakt = false } = Astro.props;
const neuester = einsaetze[0];

/** Kleine Symbole zu den Einsatzarten (Pfade wie in der Einsatzbilanz) */
const ICONS: Record<string, string> = {
  THL: 'M14 7l3 3M5 6l3-3 4 4-3 3zM12 10l7 7-3 3-7-7zM16 3l5 5',
  Brand: 'M12 3c1 4-3 5-3 9a3 3 0 0 0 6 0c0-2-1-3-1-3s4 1 4 5a6 6 0 0 1-12 0c0-6 5-7 6-11z',
  Sonstige: 'M9 10.6a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2zM16.5 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM3.5 20c0-3.2 2.4-5 5.5-5s5.5 1.8 5.5 5M13.5 15.6c.9-.7 2-1.1 3-1.1 2.3 0 4 1.5 4 4',
};
/** "Neu" nur, wenn der Einsatz keine 6 Stunden her ist (Browser prüft zusätzlich nach) */
const istNeu = (w: Date) => Date.now() - w.getTime() < 6 * 60 * 60 * 1000;
---

<div class:list={['monitorkarte', { kompakt }]} id="einsaetze">
  <div class="kopf">
    <div class="t">
      <span class="badge-live"><i></i>Live</span>
      <h2>Einsatzticker</h2>
    </div>
  </div>
  <ol>
    {
      einsaetze.map((e, i) => (
        <li>
          <span class="zeit">{e.datum} · {e.zeit}</span>
          <span class="was">
            <b class:list={['art', e.art.toLowerCase()]}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ICONS[e.art]} /></svg>
              {e.art}
            </b> – {e.stichwort}
            {i === 0 && istNeu(e.wann) && <em class="neu" data-wann={e.wann.toISOString()}>Neu</em>}
          </span>
        </li>
      ))
    }
  </ol>
  <div class="fuss">
    <a href="/einsaetze/">Alle Einsätze &amp; Statistik →</a>
    <span>Stand: {neuester?.datum}, {neuester?.zeit} Uhr</span>
  </div>
</div>

<script>
  /* "Neu"-Schild entfernen, wenn der Einsatz beim Betrachten älter als 6 Stunden ist */
  const grenze = Date.now() - 6 * 60 * 60 * 1000;
  document.querySelectorAll<HTMLElement>('em.neu[data-wann]').forEach((el) => {
    if (Date.parse(el.dataset.wann!) < grenze) el.remove();
  });
</script>
