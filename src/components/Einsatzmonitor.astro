---
import { EINSATZ_ICONS as ICONS } from '../lib/einsatz-icons';

interface Einsatz {
  wann: Date;
  datum: string;
  zeit: string;
  stichwort: string;
  art: 'Brand' | 'THL' | 'ABC' | 'Sonstige';
}

interface Props {
  einsaetze: Einsatz[];
  /** Kompakte Darstellung für schmale Spalten */
  kompakt?: boolean;
}

const { einsaetze, kompakt = false } = Astro.props;
const neuester = einsaetze[0];

/** "Neu" nur, wenn der Einsatz keine 12 Stunden her ist (Browser prüft zusätzlich nach) */
const istNeu = (w: Date) => Date.now() - w.getTime() < 12 * 60 * 60 * 1000;
---

<div
  class:list={['monitorkarte', { kompakt }]}
  id="einsaetze"
  data-quelle="/einsaetze.json"
  data-stand={neuester?.wann.toISOString()}
>
  <div class="kopf">
    <div class="t">
      <span class="badge-live"><i></i>Live</span>
      <h2>Einsatzticker</h2>
    </div>
  </div>
  <ol>
    {
      einsaetze.map((e, i) => (
        <li>
          <span class="zeit">{e.datum} · {e.zeit}</span>
          <span class="was">
            <b class:list={['art', e.art.toLowerCase()]}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ICONS[e.art]} /></svg>
              {e.art}
            </b> – {e.stichwort}
            {i === 0 && istNeu(e.wann) && <em class="neu" data-wann={e.wann.toISOString()}>Neu</em>}
          </span>
        </li>
      ))
    }
  </ol>
  <div class="fuss">
    <a href="/einsaetze/">Alle Einsätze &amp; Statistik →</a>
    <span>Stand: {neuester?.datum}, {neuester?.zeit} Uhr</span>
  </div>
</div>

<script>
  import { beobachteEinsaetze, esc, istNeu, type EinsatzLive } from '../lib/einsatz-live';
  import { EINSATZ_ICONS } from '../lib/einsatz-icons';

  /* "Neu"-Schild entfernen, wenn der Einsatz beim Betrachten älter als 12 Stunden ist */
  const grenze = Date.now() - 12 * 60 * 60 * 1000;
  document.querySelectorAll<HTMLElement>('em.neu[data-wann]').forEach((el) => {
    if (Date.parse(el.dataset.wann!) < grenze) el.remove();
  });

  /* Frische Einsätze nachladen – die Startseite kommt oft noch bis zu
     10 Minuten aus dem Cache, der Monitor soll trotzdem aktuell sein */
  const karte = document.querySelector<HTMLElement>('.monitorkarte[data-quelle]');
  const liste = karte?.querySelector('ol');
  if (karte && liste) {
    const anzahl = liste.children.length || 5;
    beobachteEinsaetze(karte.dataset.quelle!, karte.dataset.stand ?? '', (einsaetze: EinsatzLive[]) => {
      liste.innerHTML = einsaetze
        .slice(0, anzahl)
        .map(
          (e, i) =>
            `<li><span class="zeit">${esc(e.datum)} · ${esc(e.zeit)}</span><span class="was">` +
            `<b class="art ${e.art.toLowerCase()}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="${EINSATZ_ICONS[e.art]}"/></svg> ${esc(e.art)}</b>` +
            ` – ${esc(e.stichwort)}` +
            (i === 0 && istNeu(e.wann) ? ' <em class="neu">Neu</em>' : '') +
            `</span></li>`
        )
        .join('');
      const stand = karte.querySelector('.fuss span');
      const neuester = einsaetze[0];
      if (stand && neuester) stand.textContent = `Stand: ${neuester.datum}, ${neuester.zeit} Uhr`;
    });
  }
</script>
