---
import SkylineWeiden from './SkylineWeiden.astro';

interface Props {
  ticker?: { wann: Date; datum: string; zeit: string; stichwort: string }[];
}
const { ticker = [] } = Astro.props;
/** "Neu" nur, wenn der Einsatz keine 12 Stunden her ist (Browser prüft zusätzlich nach) */
const istNeu = (w: Date) => Date.now() - w.getTime() < 12 * 60 * 60 * 1000;

const folien = [
  { bild: '/bilder/header/absturz.jpg', titel: 'Absturzsicherung im Einsatz' },
  { bild: '/bilder/header/nachtbrand.jpg', titel: 'Großbrand bei Nacht' },
  { bild: '/bilder/header/drohne.jpg', titel: 'Drohnengruppe · Lage aus der Luft' },
  { bild: '/bilder/header/segnung.jpg', titel: 'Fahrzeugsegnung der neuen HLF 20', pos: '68% 45%' },
  { bild: '/bilder/header/feldbrand.jpg', titel: 'Vegetationsbrand · Einsatz im Sommer' },
  { bild: '/bilder/header/garten.jpg', titel: 'Brandeinsatz · Trupp unter Atemschutz' },
  { bild: '/bilder/header/ugoeel-waldbrand.jpg', titel: 'UG-ÖEL · Waldbrand', pos: '68% 58%' },
  { bild: '/bilder/header/fahrzeuge_oben1.jpg', titel: 'Feuerwache Weiden' },
  { bild: '/bilder/header/wache2_oben.jpg', titel: 'Feuerwache 2' },
];
---

<section class="hero" id="start">
  {
    folien.map((f) => (
      <div
        class="folie"
        data-titel={f.titel}
        style={`background-image:url(${f.bild})${f.pos ? `;background-position:${f.pos}` : ''}`}
      />
    ))
  }
  <div class="duster"></div>
  <div class="glut"></div>
  <div class="inhalt">
    <div class="wrap">
      <div class="heroskyline" aria-hidden="true"><SkylineWeiden /></div>
      <div class="funkspruch"><i></i>Florian Weiden · einsatzbereit</div>
      <h1 class="display">
        <span><b>24 Stunden.</b></span>
        <span><b>365 Tage.</b></span>
        <span class="sicherheit"><b>Für Ihre Sicherheit.</b></span>
      </h1>
      <p class="sub">Herzlich Willkommen bei der Freiwilligen Feuerwehr Weiden i. d. OPf.</p>
      <div class="cta">
        <a class="btn btn-rot" href="/fuhrpark/">Unsere Fahrzeuge</a>
        <a class="btn btn-glas" href="#aktuelles">Aktuelles</a>
        <div class="steuer">
          <span class="bildtitel" id="bildtitel"></span>
          <div class="punkte" id="punkte" role="tablist" aria-label="Titelbild wählen"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="schlauch" aria-hidden="true">
    <svg viewBox="0 0 1200 90" preserveAspectRatio="none">
      <path
        id="schlauchweg"
        class="leitung"
        pathLength="1"
        d="M-20,62 C180,38 320,74 520,58 C700,44 840,70 1030,56 L1116,56"></path>
      <path
        class="fuellung"
        pathLength="1"
        d="M-20,62 C180,38 320,74 520,58 C700,44 840,70 1030,56 L1116,56"></path>
      <path
        class="glanz"
        pathLength="1"
        d="M-20,59 C180,35 320,71 520,55 C700,41 840,67 1030,53 L1116,53"></path>
      <g class="rolle" opacity="0">
        <g>
          <circle r="26" fill="none" stroke="#B00500" stroke-width="7"></circle>
          <circle r="15" fill="none" stroke="#E10600" stroke-width="6"></circle>
          <circle r="5.5" fill="#7E0400"></circle>
          <animateTransform
            attributeName="transform"
            additive="sum"
            type="scale"
            from="1"
            to="0.04"
            begin="indefinite"
            dur="3s"
            fill="freeze"></animateTransform>
          <animateTransform
            attributeName="transform"
            additive="sum"
            type="rotate"
            from="0"
            to="-1080"
            begin="indefinite"
            dur="3s"
            fill="freeze"></animateTransform>
        </g>
        <animateMotion begin="indefinite" dur="3s" fill="freeze" rotate="auto">
          <mpath href="#schlauchweg"></mpath>
        </animateMotion>
        <animate attributeName="opacity" from="0" to="1" begin="indefinite" dur="0.05s" fill="freeze"></animate>
      </g>
      <g class="rohr" opacity="0" transform="translate(1116,56)">
        <g transform="scale(1.5)">
          <rect x="0" y="-6" width="7" height="12" rx="1.5" fill="#C9CCD6" stroke="#8A8F9C" stroke-width="1"></rect>
          <path d="M7,-5 L23,-7 L23,7 L7,5 Z" fill="#3A3F4C"></path>
          <rect x="12" y="4" width="4.5" height="9" rx="1.5" fill="#22252D"></rect>
          <rect x="23" y="-8" width="8" height="16" rx="2.5" fill="#E10600"></rect>
        </g>
        <animate attributeName="opacity" from="0" to="1" begin="indefinite" dur="0.2s" fill="freeze"></animate>
        <animateTransform attributeName="transform" additive="sum" type="translate"
          from="22 0" to="0 0" begin="indefinite" dur="0.45s" fill="freeze"
          calcMode="spline" keySplines="0.2 0.8 0.3 1" keyTimes="0;1" values="22 0;0 0"></animateTransform>
      </g>
      <g class="wasser" transform="translate(1164,56)">
        <line x1="2" y1="0" x2="15" y2="-7"></line>
        <line x1="2" y1="0" x2="18" y2="-2"></line>
        <line x1="2" y1="0" x2="17" y2="3"></line>
        <line x1="2" y1="0" x2="13" y2="7"></line>
        <circle cx="22" cy="-6" r="1.4"></circle>
        <circle cx="25" cy="-1" r="1.6"></circle>
        <circle cx="21" cy="5" r="1.3"></circle>
      </g>
    </svg>
    {
      ticker.length > 0 && (
        <div class="schlauchticker" data-quelle="/einsaetze.json" data-stand={ticker[0].wann.toISOString()}>
          <div class="spur">
            {[0, 1].map(() => (
              <span class="haelfte">
                {[...ticker, ...ticker].map((e, idx) => {
                  const zeigeNeu = idx % ticker.length === 0 && istNeu(e.wann);
                  return (
                    <span class:list={['eintrag', { neu: zeigeNeu }]} data-wann={zeigeNeu ? e.wann.toISOString() : undefined}>
                      +++ {zeigeNeu && <em class="neuchip">Neu</em>}
                      <b>{e.datum} · {e.zeit}</b> · {e.stichwort}
                    </span>
                  );
                })}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
  <div class="verlauf"></div>
</section>

<script>
  import { beobachteEinsaetze, esc, istNeu, type EinsatzLive } from '../lib/einsatz-live';

  /* "Neu" im Lauftext entfernen, wenn der Einsatz beim Betrachten älter als 12 Stunden ist */
  const neuGrenze = Date.now() - 12 * 60 * 60 * 1000;
  document.querySelectorAll<HTMLElement>('.eintrag[data-wann]').forEach((el) => {
    if (Date.parse(el.dataset.wann!) < neuGrenze) {
      el.classList.remove('neu');
      el.querySelector('.neuchip')?.remove();
    }
  });

  /* Frische Einsätze nachladen – die Startseite kommt oft noch bis zu
     10 Minuten aus dem Cache, der Lauftext soll trotzdem aktuell sein */
  const laufband = document.querySelector<HTMLElement>('.schlauchticker[data-quelle]');
  if (laufband) {
    const haelften = laufband.querySelectorAll<HTMLElement>('.haelfte');
    const anzahl = Math.max(1, Math.round((haelften[0]?.querySelectorAll('.eintrag').length ?? 8) / 2));
    beobachteEinsaetze(laufband.dataset.quelle!, laufband.dataset.stand ?? '', (einsaetze: EinsatzLive[]) => {
      const auswahl = einsaetze.slice(0, anzahl);
      const inhalt = [...auswahl, ...auswahl]
        .map((e, idx) => {
          const zeigeNeu = idx % auswahl.length === 0 && istNeu(e.wann);
          return (
            `<span class="eintrag${zeigeNeu ? ' neu' : ''}"${zeigeNeu ? ` data-wann="${esc(e.wann)}"` : ''}>` +
            `+++ ${zeigeNeu ? '<em class="neuchip">Neu</em>' : ''}` +
            `<b>${esc(e.datum)} · ${esc(e.zeit)}</b> · ${esc(e.stichwort)}</span>`
          );
        })
        .join('');
      haelften.forEach((h) => (h.innerHTML = inhalt));
    });
  }

  const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Schlauchrolle & Strahlrohr exakt synchron zur ausrollenden Leitung starten
     (die Leitung beginnt per CSS 0,9s nach body.los, Dauer 3s) */
  const starteSchlauch = () => {
    if (document.body.classList.contains('sofort') || reduziert) return;
    const rolle = document.querySelectorAll<SVGAnimationElement>(
      '.hero .schlauch .rolle animate, .hero .schlauch .rolle animateTransform, .hero .schlauch .rolle animateMotion'
    );
    const rohr = document.querySelectorAll<SVGAnimationElement>(
      '.hero .schlauch .rohr animate, .hero .schlauch .rohr animateTransform'
    );
    setTimeout(() => rolle.forEach((a) => a.beginElement()), 900);
    setTimeout(() => rohr.forEach((a) => a.beginElement()), 4000);
  };
  if (document.body.classList.contains('los')) starteSchlauch();
  else addEventListener('feuerwehr:los', starteSchlauch, { once: true });

  const folien = document.querySelectorAll<HTMLElement>('.hero .folie');
  const punkte = document.getElementById('punkte')!;
  const bildtitel = document.getElementById('bildtitel')!;
  let timer: ReturnType<typeof setInterval> | null = null;

  // Bei jedem Seitenaufruf eine andere Bild-Reihenfolge (Fisher-Yates)
  const abfolge = [...folien.keys()];
  for (let i = abfolge.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [abfolge[i], abfolge[j]] = [abfolge[j], abfolge[i]];
  }
  let pos = 0;

  folien.forEach((f, i) => {
    const p = document.createElement('button');
    p.setAttribute('aria-label', `Bild ${i + 1}`);
    p.addEventListener('click', () => {
      pos = abfolge.indexOf(i);
      zeige(i);
      start();
    });
    punkte.appendChild(p);
  });

  function zeige(i: number) {
    folien.forEach((f, j) => f.classList.toggle('an', j === i));
    punkte.querySelectorAll('button').forEach((b, j) => b.classList.toggle('an', j === i));
    bildtitel.textContent = folien[i].dataset.titel ?? '';
  }
  function start() {
    if (timer) clearInterval(timer);
    if (!reduziert)
      timer = setInterval(() => {
        pos = (pos + 1) % abfolge.length;
        zeige(abfolge[pos]);
      }, 8000);
  }
  zeige(abfolge[0]);
  start();

  /* Schlauchfarbe pro Besuch zufällig: rot, leuchtgelb oder weiß –
     "Für Ihre Sicherheit." färbt sich passend mit */
  const heroEl = document.querySelector<HTMLElement>('.hero');
  if (heroEl) {
    const farben = [
      // rot (bisher): Zeilen weiß, "Für Ihre Sicherheit." rot
      { basis: 'var(--rot)', fuell: '#FF3B30', tief: '#B00500', kern: '#7E0400', zeilen: '#fff', sicherheit: '#FF3B30' },
      // leuchtgelb: Zeilen weiß, Sicherheit gelb
      { basis: '#D8CE00', fuell: '#F2FF00', tief: '#A89A00', kern: '#756B00', zeilen: '#fff', sicherheit: '#F2FF00' },
      // weiß: 24 Stunden / 365 Tage rot, Sicherheit weiß
      { basis: '#C9CDD6', fuell: '#FFFFFF', tief: '#9AA0AD', kern: '#6E7480', zeilen: '#FF3B30', sicherheit: '#FFFFFF' },
    ];
    const wahl = farben[Math.floor(Math.random() * farben.length)];
    heroEl.style.setProperty('--schlauch-basis', wahl.basis);
    heroEl.style.setProperty('--schlauch-fuell', wahl.fuell);
    heroEl.style.setProperty('--schlauch-tief', wahl.tief);
    heroEl.style.setProperty('--schlauch-kern', wahl.kern);
    heroEl.style.setProperty('--zeilen-farbe', wahl.zeilen);
    heroEl.style.setProperty('--sicherheit-farbe', wahl.sicherheit);
  }

  /* Druckstoß: sporadisch (alle ~35–90 s) füllt sich der Schlauch sichtbar neu.
     Direkt nach dem Intro spritzt nur die Düse (die Füllung läuft da gerade
     zum ersten Mal durch) – sonst setzt der Puls die Befüllung mittendrin zurück. */
  const schlauchEl = document.querySelector<HTMLElement>('.hero .schlauch');
  const fuellung = schlauchEl?.querySelector<SVGPathElement>('.fuellung');
  if (schlauchEl && fuellung && !reduziert) {
    const spritz = () => {
      schlauchEl.classList.remove('pulsiert');
      void schlauchEl.offsetWidth;
      schlauchEl.classList.add('pulsiert');
    };
    const puls = () => {
      // Füll-Animation erneut abspielen (Web Animations API überlagert die
      // CSS-Animation und startet sauber neu), Düse spritzt wenn der Druck ankommt
      fuellung.animate(
        [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }],
        { duration: 3200, easing: 'ease-in', fill: 'forwards' }
      );
      spritz();
      setTimeout(puls, 35000 + Math.random() * 55000);
    };
    const start = () => {
      // Erste Füllung kommt vom Intro (CSS, 10,6s + 3,6s nach "los"):
      // dann nur spritzen, die Puls-Kette folgt deutlich später
      setTimeout(spritz, document.body.classList.contains('sofort') ? 2500 : 14300);
      setTimeout(puls, 45000 + Math.random() * 45000);
    };
    if (document.body.classList.contains('los')) start();
    else addEventListener('feuerwehr:los', start, { once: true });
  }

  /* Schlauch-Ticker: je 1 Durchlauf (aktuellste 4 Meldungen), dann 60 s Pause – endlos */
  const tickerBox = document.querySelector<HTMLElement>('.schlauchticker');
  const tickerSpur = tickerBox?.querySelector<HTMLElement>('.spur');
  if (tickerBox && tickerSpur && !reduziert) {
    let verbleibend = 1;
    tickerSpur.addEventListener('animationiteration', (e) => {
      if (e.animationName !== 'schlauchlauf') return; // Blink-Animationen der Kinder ignorieren
      verbleibend--;
      if (verbleibend > 0) return;
      tickerBox.classList.add('ruhe');
      setTimeout(() => {
        tickerSpur.style.animationPlayState = 'paused';
      }, 900);
      setTimeout(() => {
        verbleibend = 1;
        tickerSpur.style.animationPlayState = 'running';
        tickerBox.classList.remove('ruhe');
      }, 60000);
    });
  }
</script>
