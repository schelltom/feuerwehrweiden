---
/**
 * Sonderlayout für die UG-ÖEL (Einheiten) – im Stil der Drohnengruppe.
 * Auftrag, Katastrophenschutz, Alarmierung, verlinkte Technik (ELW + Anhänger),
 * Galerie und – ganz am Ende – Leitung & Kontakt.
 * Nutzt die globalen Bausteine (.eyebrow, .display, .specs, .galerie, .reveal).
 * Rückbau: Sonderfall in feuerwehr/[bereich]/[slug].astro entfernen.
 */
import Seitenkopf from './Seitenkopf.astro';

interface Person {
  name: string;
  funktion?: string;
  telefon?: string;
  email?: string;
}
interface Kontakt {
  name?: string;
  telefon?: string;
  fax?: string;
  email?: string;
  adresse?: string;
}
interface Props {
  d: {
    titel: string;
    kurz?: string;
    titelbild?: string;
    kontakt?: Kontakt;
    personen: Person[];
  };
}
const { d } = Astro.props;

const eckdaten = [
  { label: 'Funkrufname', wert: 'Kater Weiden 1/12/1' },
  { label: 'Anforderung', wert: 'Großschadenslagen' },
  { label: 'Kernaufgabe', wert: 'Einsatzleitung' },
  { label: 'Bereich', wert: 'Katastrophenschutz' },
];

const auftrag = ['Erkundung der Lage', 'Einsatzplanung', 'Unterstützung bei der Befehlsgebung'];

const katsschutz = [
  'Örtliche Einsatzleitung einrichten und kennzeichnen',
  'Kommunikationsverbindungen herstellen und betreiben',
  'ÖEL bei der Erkundung der Lage unterstützen',
  'ÖEL bei der Einsatzplanung unterstützen',
  'Eingesetzte Kräfte koordinieren und überwachen',
  'Führen der Lagekarte',
  'Führen des Einsatztagebuches',
];

const alarmstufen = [
  'Großbrand',
  'Große technische Hilfeleistung',
  'Gefahrgutunfall',
  'Katastrophenfall',
  'Personensuche',
  'Unwetterlagen',
  'Sonstige Anforderung durch den Einsatzleiter',
];

const technik = [
  {
    href: '/fuhrpark/elw-1-5/',
    bild: '/bilder/fahrzeuge/elw.jpg',
    typ: 'Einsatzleitwagen',
    name: 'ELW 1,5',
    text: 'Mobiler Führungsarbeitsraum auf Mercedes-Benz Sprinter 519 CDI (Bj. 2020, Besatzung 1:3) mit Tetra-Funk, Einsatznavigation und 4-Punkt-Abstützung.',
    tags: ['Kater Weiden 1/12/1', 'Tetra-Funk', 'Besatzung 1:3'],
  },
  {
    href: '/fuhrpark/anh-ug-oeel/',
    bild: '/bilder/fahrzeuge/a_ug.jpg',
    typ: 'Anhänger',
    name: 'Anhänger UG-ÖEL',
    text: 'Ergänzt die Einsatzleitung um Schnelleinsatzzelt, leistungsstarke Beleuchtung und Kommunikationstechnik für den autarken Betrieb vor Ort.',
    tags: ['Schnelleinsatzzelt', 'Apollo-LED', 'Feldtelefon & MOPS'],
  },
];

const galerie = [
  { bild: '/bilder/uploads/2026/ug2.jpg', text: 'Funkarbeitsplatz' },
  { bild: '/bilder/uploads/2026/ug3.jpg', text: 'Örtliche Einsatzleitung' },
  { bild: '/bilder/uploads/2026/ug5.jpg', text: 'Lagearbeit vor Ort' },
  { bild: '/bilder/uploads/2026/ug6.jpg', text: 'Führungsunterstützung' },
];

const telHref = (t: string) => `tel:${t.replace(/[^+\d]/g, '')}`;
---

<main>
  <Seitenkopf
    titel={d.titel}
    krumen={[
      { name: 'Start', href: '/' },
      { name: 'Feuerwehr', href: '/feuerwehr/' },
      { name: 'Einheiten' },
    ]}
    untertitel="Unterstützungsgruppe Örtliche Einsatzleitung"
    bild="/bilder/uploads/2026/ug1.jpg"
    kenburns
    gerade
  />

  <!-- Einleitung -->
  <section>
    <div class="wrap" style="padding-bottom:clamp(12px,1.5vw,18px)">
      <div class="ug-introtext reveal">
        <span class="eyebrow">Führungsunterstützung</span>
        <h2 class="display">Koordination bei Großschadenslagen</h2>
        <p class="lead">
          Die UG-ÖEL besteht aus aktiven Mitgliedern der Freiwilligen Feuerwehr der Stadt Weiden und
          unterstützt den Einsatzleiter. Angefordert wird sie vor allem bei Großschadensfällen –
          also über Stunden oder Tage andauernden Einsätzen und einem Großaufgebot an Hilfskräften,
          das eine zentrale Koordinierung notwendig macht.
        </p>
        <p>
          Zusätzlich zum normalen Feuerwehrdienst verrichtet die Gruppe anfallende Aufgaben des
          Katastrophenschutzes und bildet ein Bindeglied zwischen Einsatzleiter, Zug- und
          Gruppenführern sowie der Feuerwehreinsatzzentrale.
        </p>
      </div>
    </div>
  </section>

  <!-- Eckdaten -->
  <section>
    <div class="wrap" style="padding-top:0;padding-bottom:clamp(20px,2.5vw,30px)">
      <div class="specs reveal">
        {eckdaten.map((k) => (
          <div class="spec">
            <span>{k.label}</span>
            <b>{k.wert}</b>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Unser Auftrag -->
  <section class="ug-band">
    <div class="wrap" style="padding-block:clamp(30px,4vw,48px)">
      <span class="eyebrow">Unser Auftrag</span>
      <h2 class="display ug-h">An der Seite des Einsatzleiters</h2>
      <p class="ug-teaser">
        Bei umfangreichen Lagen unterstützt die UG-ÖEL den Einsatzleiter in allen Führungsaufgaben –
        von der ersten Erkundung bis zur laufenden Einsatzplanung.
      </p>
      <ul class="ug-liste reveal">
        {auftrag.map((a) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            <span>{a}</span>
          </li>
        ))}
      </ul>
      <p class="ug-schluss">
        Sie stellt die Kommunikationsverbindung her und hält sie aufrecht, übernimmt Verwaltungs- und
        organisatorische Aufgaben und erstellt vor Ort die Einsatzdokumentation.
      </p>
    </div>
  </section>

  <!-- Katastrophenschutz -->
  <section>
    <div class="wrap ug-kats" style="padding-top:clamp(28px,3.5vw,44px)">
      <figure class="ug-katsbild reveal">
        <img src="/bilder/uploads/2026/ug4.jpg" alt="UG-ÖEL im Katastrophenschutz" loading="lazy" />
      </figure>
      <div class="ug-katstext reveal">
        <span class="eyebrow">Im Katastrophenschutz</span>
        <h2 class="display">Aufgaben der Örtlichen Einsatzleitung</h2>
        <ul class="ug-check">
          {katsschutz.map((k) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span>{k}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Alarmierung -->
  <section class="ug-band">
    <div class="wrap" style="padding-block:clamp(30px,4vw,48px)">
      <span class="eyebrow">Alarmierung</span>
      <p class="ug-teaser" style="margin-top:16px">
        Die Alarmierung der UG-ÖEL erfolgt mittels Sonderschleife über den Funkmeldeempfänger – bei
        folgenden Alarmstufen:
      </p>
      <div class="ug-tags reveal">
        {alarmstufen.map((a) => (
          <span>{a}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Technik & Fahrzeuge -->
  <section>
    <div class="wrap" style="padding-top:clamp(28px,3.5vw,44px)">
      <span class="eyebrow">Technik &amp; Fahrzeuge</span>
      <h2 class="display ug-h">Mobile Einsatzleitung</h2>
      <div class="ug-technik reveal">
        {technik.map((t) => (
          <a class="ug-fzkarte" href={t.href}>
            <span class="ug-fzbild">
              <img src={t.bild} alt={t.name} loading="lazy" />
            </span>
            <span class="ug-fztext">
              <span class="eyebrow">{t.typ}</span>
              <b class="display">{t.name}</b>
              <span class="ug-fzbeschr">{t.text}</span>
              <span class="ug-fztags">
                {t.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </span>
              <span class="ug-mehr">Mehr erfahren →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Galerie -->
  <section>
    <div class="wrap" style="padding-top:clamp(20px,2.5vw,32px)">
      <span class="eyebrow" style="display:inline-flex">Einblicke</span>
      <div class="galerie reveal" style="margin-top:16px">
        {galerie.map((g) => (
          <figure>
            <img src={g.bild} alt={g.text} loading="lazy" />
            <figcaption>{g.text}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Leitung & Kontakt (am Ende) -->
  <section class="ug-band">
    <div class="wrap" style="padding-block:clamp(30px,4vw,48px)">
      <span class="eyebrow">Leitung &amp; Kontakt</span>
      <h2 class="display ug-h">Ansprechpartner</h2>

      {d.personen.length > 0 && (
        <div class="ug-personen reveal">
          {d.personen.map((p) => (
            <div class="ug-person">
              {p.funktion && <em>{p.funktion}</em>}
              <b class="display">{p.name}</b>
              {p.telefon && <a href={telHref(p.telefon)}>{p.telefon}</a>}
              {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
            </div>
          ))}
        </div>
      )}

      <div class="ug-kontaktgrid reveal">
        {d.kontakt && (
          <div class="ug-kontakt">
            <span class="eyebrow">{d.kontakt.name}</span>
            <ul>
              {d.kontakt.telefon && (
                <li>
                  <span>Telefon</span>
                  <a href={telHref(d.kontakt.telefon)}>{d.kontakt.telefon}</a>
                </li>
              )}
              {d.kontakt.fax && (
                <li>
                  <span>Telefax</span>
                  <b>{d.kontakt.fax}</b>
                </li>
              )}
              {d.kontakt.email && (
                <li>
                  <span>E-Mail</span>
                  <a href={`mailto:${d.kontakt.email}`}>{d.kontakt.email}</a>
                </li>
              )}
              {d.kontakt.adresse && (
                <li>
                  <span>Anschrift</span>
                  <b>{d.kontakt.adresse}</b>
                </li>
              )}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
</main>

<style>
  section {
    scroll-margin-top: 90px;
  }
  /* Enger als der globale Standard (64–110px) */
  section .wrap {
    padding-block: clamp(26px, 3.5vw, 44px);
  }

  /* ---- Einleitung ---- */
  .ug-introtext h2 {
    font-style: italic;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    margin: 10px 0 14px;
    line-height: 1.02;
  }
  .ug-introtext .lead {
    font-size: 1.12rem;
    color: #2c313c;
    margin: 0 0 14px;
  }
  .ug-introtext p {
    color: var(--tinte2);
    margin: 0 0 12px;
  }

  .specs {
    margin: 0 !important;
  }

  /* ---- Dunkle Bänder ---- */
  .ug-band {
    background: var(--dunkel);
    color: #eef0f5;
    position: relative;
  }
  .ug-band::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--rot);
  }
  .ug-band .eyebrow {
    color: var(--rot-hell);
  }
  .ug-h {
    font-style: italic;
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    margin: 12px 0 16px;
  }
  .ug-teaser {
    max-width: 70ch;
    font-size: 1.04rem;
    color: #c1c6d2;
    margin: 0 0 24px;
  }
  .ug-schluss {
    max-width: 72ch;
    color: #c1c6d2;
    margin: 0;
  }

  /* ---- Checkliste (dunkel) ---- */
  .ug-liste {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  @media (max-width: 760px) {
    .ug-liste {
      grid-template-columns: 1fr;
    }
  }
  .ug-liste li {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--dunkel2);
    border: 1px solid var(--hell-linie);
    border-left: 3px solid var(--rot);
    padding: 14px 18px;
    font-size: 1rem;
  }
  .ug-liste svg,
  .ug-check svg {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--rot-hell);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- Katastrophenschutz: Bild + Checkliste ---- */
  .ug-kats {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .ug-katsbild {
    margin: 0;
    border: 1px solid var(--linie);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(20, 22, 28, 0.1);
  }
  .ug-katsbild img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .ug-katsbild:hover img {
    transform: scale(1.04);
  }
  .ug-katstext h2 {
    font-style: italic;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin: 10px 0 18px;
    line-height: 1.04;
  }
  .ug-katstext .eyebrow {
    display: inline-flex;
  }
  @media (max-width: 820px) {
    .ug-kats {
      grid-template-columns: 1fr;
    }
    .ug-katsbild {
      order: 2;
    }
  }
  .ug-check {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ug-check li {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--karte);
    border: 1px solid var(--linie);
    border-left: 3px solid var(--rot);
    padding: 12px 16px;
    font-size: 0.98rem;
  }
  .ug-check svg {
    stroke: var(--rot);
  }

  /* ---- Tags (Alarmstufen) ---- */
  .ug-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ug-tags span {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--dunkel2);
    border: 1px solid var(--hell-linie);
    border-left: 3px solid var(--rot);
    padding: 9px 14px;
  }

  /* ---- Technik: verlinkte Fahrzeugkarten ---- */
  .ug-technik {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (max-width: 720px) {
    .ug-technik {
      grid-template-columns: 1fr;
    }
  }
  .ug-fzkarte {
    display: grid;
    grid-template-columns: 40% 1fr;
    background: var(--karte);
    border: 1px solid var(--linie);
    border-top: 3px solid var(--rot);
    box-shadow: 0 2px 10px rgba(20, 22, 28, 0.05);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .ug-fzkarte:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(20, 22, 28, 0.14);
  }
  .ug-fzbild {
    overflow: hidden;
  }
  .ug-fzbild img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 190px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .ug-fzkarte:hover .ug-fzbild img {
    transform: scale(1.05);
  }
  .ug-fztext {
    display: block;
    padding: 20px 22px 22px;
  }
  .ug-fztext .eyebrow {
    display: inline-flex;
  }
  .ug-fztext b {
    display: block;
    font-style: italic;
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1.05;
    margin: 8px 0 10px;
  }
  .ug-fzbeschr {
    display: block;
    color: var(--tinte2);
    font-size: 0.94rem;
    margin-bottom: 12px;
  }
  .ug-fztags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 14px;
  }
  .ug-fztags span {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rot-tief);
    background: rgba(225, 6, 0, 0.07);
    border: 1px solid rgba(225, 6, 0, 0.2);
    padding: 6px 10px;
  }
  .ug-mehr {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rot);
  }
  @media (max-width: 480px) {
    .ug-fzkarte {
      grid-template-columns: 1fr;
    }
    .ug-fzbild img {
      min-height: 200px;
      max-height: 240px;
    }
  }

  /* ---- Leitung: Personen ---- */
  .ug-personen {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 20px;
  }
  @media (max-width: 760px) {
    .ug-personen {
      grid-template-columns: 1fr;
    }
  }
  .ug-person {
    background: var(--dunkel2);
    border: 1px solid var(--hell-linie);
    border-top: 3px solid var(--rot);
    padding: 20px 20px 22px;
  }
  .ug-person em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rot-hell);
  }
  .ug-person b {
    display: block;
    font-style: italic;
    text-transform: uppercase;
    font-size: 1.35rem;
    line-height: 1.05;
    margin: 6px 0 10px;
    color: #fff;
  }
  .ug-person a {
    display: block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: #c8ccd6;
    text-decoration: none;
    word-break: break-word;
  }
  .ug-person a:hover {
    color: var(--rot-hell);
  }

  /* ---- Kontaktdaten ---- */
  .ug-kontaktgrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .ug-kontakt {
    background: var(--dunkel2);
    border: 1px solid var(--hell-linie);
    padding: 22px 24px 24px;
  }
  .ug-kontakt .eyebrow {
    display: inline-flex;
    margin-bottom: 14px;
  }
  .ug-kontakt ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .ug-kontakt li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hell-linie);
    font-size: 0.95rem;
    color: #eef0f5;
  }
  .ug-kontakt li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .ug-kontakt li span {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9aa0ad;
    padding-top: 3px;
  }
  .ug-kontakt li b {
    font-weight: 500;
    font-family: var(--text);
  }
  .ug-kontakt a {
    color: var(--rot-hell);
    text-decoration: none;
    word-break: break-word;
  }
  .ug-kontakt a:hover {
    text-decoration: underline;
  }
</style>
