---
/**
 * Schmaler Startseiten-Streifen: zeigt abholbereite Atemschutz-/Schlauch-Anlieferungen
 * mit Live-Zahl und verlinkt zu den Abholung-Seiten. Erscheint nur, wenn >0 abholbereit.
 * Rückbau: <AbholStreifen /> aus index.astro entfernen, Datei löschen.
 */
import { ladePflege, ladeSchlaeuche } from '../lib/pflege';

const atemschutz = (await ladePflege()).filter((v) => v.abholbereit && !v.abgeholt).length;
const schlaeuche = (await ladeSchlaeuche()).filter((v) => v.abholbereit && !v.abgeholt).length;
---

{
  atemschutz + schlaeuche > 0 && (
    <div class="abholstreifen">
      <div class="ab-innen">
        <span class="ab-label">
          <span class="ab-punkt" aria-hidden="true" />
          Abholbereit
        </span>
        <div class="ab-links">
          {atemschutz > 0 && (
            <a href="/service/atemschutz/" class="ab-pill">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="8" y="7" width="8" height="14" rx="4" />
                <path d="M10 7V4h4v3" />
                <path d="M9.5 4h5" />
              </svg>
              <span>
                <b>{atemschutz}</b> Atemschutz
              </span>
              <span class="ab-pfeil" aria-hidden="true">→</span>
            </a>
          )}
          {schlaeuche > 0 && (
            <a href="/service/schlaeuche/" class="ab-pill">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="12" r="8" />
                <circle cx="11" cy="12" r="3.2" />
                <path d="M19 12h3" />
              </svg>
              <span>
                <b>{schlaeuche}</b> {schlaeuche === 1 ? 'Schlauch' : 'Schläuche'}
              </span>
              <span class="ab-pfeil" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </div>
  )
}

<style>
  .abholstreifen {
    background: var(--karte);
    border: 1px solid var(--linie);
    box-shadow: 0 2px 10px rgba(20, 22, 28, 0.05);
  }
  .ab-innen {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px;
  }
  .ab-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    color: var(--tinte2);
  }
  .ab-punkt {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1a9b4e;
    animation: ab-puls 2s infinite;
  }
  @keyframes ab-puls {
    0% { box-shadow: 0 0 0 0 rgba(26, 155, 78, 0.55); }
    70% { box-shadow: 0 0 0 10px rgba(26, 155, 78, 0); }
    100% { box-shadow: 0 0 0 0 rgba(26, 155, 78, 0); }
  }
  .ab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ab-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    box-sizing: border-box;
    max-width: 100%;
    text-decoration: none;
    color: var(--tinte);
    background: #fff;
    border: 1px solid var(--linie);
    border-left: 3px solid #1a9b4e;
    padding: 6px 11px;
    font-family: var(--display);
    font-style: italic;
    text-transform: uppercase;
    font-size: 0.78rem;
    box-shadow: 0 2px 10px rgba(20, 22, 28, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ab-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(20, 22, 28, 0.14);
  }
  .ab-pill svg {
    color: #1a9b4e;
    flex: none;
  }
  .ab-pill b {
    font-size: 1.05em;
    margin-right: 0.2em;
  }
  .ab-pfeil {
    color: #1a9b4e;
    font-style: normal;
    transition: transform 0.2s ease;
  }
  .ab-pill:hover .ab-pfeil {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-punkt { animation: none; }
    .ab-pill, .ab-pfeil { transition: none; }
  }
</style>
